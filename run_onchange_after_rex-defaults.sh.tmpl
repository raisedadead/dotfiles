#!/usr/bin/env bash
set -euo pipefail

[[ "$(uname)" == "Darwin" ]] || exit 0

{{ $themes := include "dot_config/rex/themes/custom-themes.json" -}}
: 'themes {{ $themes | sha256sum }}'
THEMES="$HOME/.config/rex/themes/custom-themes.json"
D=com.superlogical.rex

w() { defaults write "$D" "$@"; }

if [[ -x "$HOME/.bin/rex" ]]; then
	"$HOME/.bin/rex" --autostart=false terminfo setup --entry-only >/dev/null ||
		echo "rex-defaults: rex terminfo setup --entry-only failed" >&2
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
defaults export "$D" "$tmp/app.plist"
/usr/libexec/PlistBuddy -c 'Print :Workspace.customThemes' "$tmp/app.plist" \
	>"$tmp/app.json" 2>/dev/null || echo '[]' >"$tmp/app.json"
hex=$(jq -cj --slurpfile app "$tmp/app.json" \
	'map(.id) as $ids | . + [$app[0][] | select(.id | IN($ids[]) | not)]' "$THEMES" |
	xxd -p | tr -d '\n') || {
	echo "rex-defaults: cannot merge $THEMES with $D Workspace.customThemes" >&2
	exit 1
}
[[ -n "$hex" ]] || {
	echo "rex-defaults: $THEMES is empty" >&2
	exit 1
}

w Workspace.animationStyle -string snappy
w Workspace.appIconVisibility -string dockAndMenuBar
w Workspace.appearance -string dark
w Workspace.darkThemeID -string "{{ (index ($themes | fromJson) 0).id }}"
w Workspace.lightThemeID -string merino-light
w Workspace.inactivePaneFadeMode -string both
w Workspace.interfaceStyle -string blendTheme
w Workspace.paneDensity -string compact
w Workspace.shellIconTheme -string themed
w Workspace.sidebarPosition -string left
w Workspace.sidebarShowsActivity -bool false
w Workspace.tabIconTintMode -string off
w Workspace.tabStyle -string vertical
w Workspace.terminalAllowsLigatures -bool true
w Workspace.terminalCursorStyle -string block
w Workspace.terminalFallbackFontNames -array "Symbols Nerd Font Mono"
w Workspace.terminalFontName -string "Berkeley Mono"
w Workspace.terminalFontPointSize -float 14
w Workspace.terminalFontSmoothing -bool true
w Workspace.terminalImproveTextContrast -bool true
w Workspace.terminalOptionKeyBehavior -string left
w Workspace.terminalUseThemePalette -bool false
w Workspace.usesPaneGlass -bool true
w Workspace.usesStandardInactiveWindowPaneStyles -bool true
w rex.agents.names-sessions -bool true
w rex.server.automatic-restart-enabled -bool true
w Workspace.customThemes -data "$hex"
