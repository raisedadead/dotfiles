#!/usr/bin/env bash
set -euo pipefail

list=0
if [[ "${1:-}" == "--list" ]]; then
	list=1
	shift
fi
if [[ $# -ne 2 || -z "$2" ]]; then
	echo "usage: rex-urls [--list] SESSION BLOCK" >&2
	exit 64
fi

# shellcheck disable=SC2016
extract='
s/\e\]8;[^;\e\a]*;([^\e\a]*)(?:\e\\|\a)/ $1 /g;
s/\e\[[0-9;]*[CGHf]/ /g;
s/\e\[[0-?]*[ -\/]*[@-~]//g;
s/\e\][^\e\a]*(?:\e\\|\a)//g;
s/\e.//g;
while (m{https?://[^\]\[\s<>"\x27`]+}g) {
	my $u = $&;
	while (1) {
		$u =~ s/[.,;:!?]+$//;
		my $open = () = $u =~ /\(/g;
		my $close = () = $u =~ /\)/g;
		last unless $close > $open && $u =~ s/\)$//;
	}
	print "$u\n";
}'
cap() { rex --autostart=false capture -s "$1" -b "$2" --format=vt "${@:3}"; }
text=$(cap "$1" "$2" --unwrap 2>/dev/null) || text=$(cap "$1" "$2")
urls=$(perl -ne "$extract" <<<"$text" | tail -r | awk '!seen[$0]++' || true)

if ((list)); then
	printf '%s\n' "$urls" | sed '/^$/d'
	exit 0
fi
if [[ -z "$urls" ]]; then
	echo "No links in this pane."
	sleep 1.5
	exit 0
fi

pick=$("$(dirname "$0")/rex-fzf" --border-label=' Links ' --prompt='open ❯ ' <<<"$urls") ||
	exit 0
open "$pick"
