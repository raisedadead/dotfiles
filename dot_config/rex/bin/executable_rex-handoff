#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "usage: rex-handoff -- COMMAND..." >&2
	exit 64
}

status() {
	local msg
	msg=$(printf '%s' "$2" | tr -d '[:cntrl:]' | cut -c1-1500 | base64 | tr -d '\n')
	printf '\e]7501;state=%s:app=handoff:msg=%s\a' "$1" "$msg"
}

inner() {
	local shown key code=0
	printf -v shown '%q ' "$@"
	printf '\n  The agent hands this command to you:\n\n    %s\n\n' "$shown"
	printf '  Enter: run it · Esc: decline\n\n'
	status blocked "Run: $shown"
	while IFS= read -rsn1 key; do
		case $key in
		'') break ;;
		$'\e' | q)
			status "done" "Declined: $shown"
			exit 130
			;;
		esac
	done
	status working "$shown"
	"$@" || code=$?
	printf '\n  exit %d · press Enter to close\n' "$code"
	IFS= read -rs _ || true
	exit "$code"
}

if [[ "${1:-}" == "--inner" ]]; then
	shift
	[[ "${1:-}" == "--" ]] && shift
	(($#)) || usage
	inner "$@"
fi

[[ "${1:-}" == "--" ]] || usage
shift
(($#)) || usage
[[ "${TERM_PROGRAM:-}" == rex && -n "${REX_SESSION:-}" && -z "${TMUX:-}" ]] || exit 0

R() { rex --autostart=false "$@"; }
args=$(jq -cn '{argv: $ARGS.positional}' --args -- "$@")
float=$(R "do" --json -s "$REX_SESSION" -b "$REX_BLOCK" handoff_float --args "$args" |
	jq -r .block_id)
code=0
R wait "$float" >/dev/null 2>&1 || code=$?
echo "$code"
exit "$code"
