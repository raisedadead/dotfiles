# Application Behavior
quit-after-last-window-closed = true

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify

# Shell Integration
shell-integration-features = sudo

# Quick Terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 50%,50%
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.1

# Clipboard
clipboard-read = allow

# Scrollbar
scrollbar = never

# Progress
progress-style = false

# Window & Display
window-save-state = always
window-theme = system
window-padding-balance = true
window-padding-x = 8
window-padding-y = 8
window-padding-color = extend

# Appearance & Transparency
background-opacity = 0.75
background-blur = macos-glass-regular
# Official catppuccin/ghostty theme; the bundled "Catppuccin Mocha" differs.
theme = catppuccin-mocha.conf
background = 11111b
bold-color = bright
# Dim text over glass: zsh suggestions use palette 8, faint text is SGR 2.
palette = 8=#6c7086
faint-opacity = 1
# Derive colours 16-255 from the theme instead of the xterm defaults.
palette-generate = true

# Mouse & Selection
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:0.5

# Typography
font-family = "Berkeley Mono"
font-thicken = true
font-size = 14
font-feature = calt
font-feature = ss01
font-feature = zero
font-codepoint-map = U+E000-U+F8FF=Symbols Nerd Font
font-codepoint-map = U+F0000-U+FFFFF=Symbols Nerd Font

# Shaders
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/text_glow.glsl

# macOS Specific
macos-titlebar-style = hidden
macos-option-as-alt = left

# Keybindings
keybind = ctrl+enter=text:\r

# Ctrl+Shift word/line editing (see zsh/.zshrc). Legacy encoding cannot
# distinguish Ctrl+Shift+X from Ctrl+X — both are one control byte — so rewrite
# each as ESC + that byte (`^[^X`, i.e. tmux M-C-x). This gives keybinds.conf
# one sequence to route in every key mode: vim panes get the plain Ctrl+X
# back, everything else gets M-C-x. The rewrite runs before key encoding, so
# it applies whether the app requests legacy, modifyOtherKeys or kitty keys.
# The rewrite is terminal-wide: outside tmux these reach whatever app is
# running as ESC+Ctrl+X, with no vim arbitration.
keybind = ctrl+shift+w=text:\x1b\x17
keybind = ctrl+shift+e=text:\x1b\x05
keybind = ctrl+shift+a=text:\x1b\x01
keybind = ctrl+shift+s=text:\x1b\x13

# Scrollback
keybind = ctrl+shift+j=scroll_page_lines:5
keybind = ctrl+shift+k=scroll_page_lines:-5
keybind = ctrl+shift+h=scroll_to_top
keybind = ctrl+shift+l=scroll_to_bottom

# Background toggle (opaque for screen recording)
keybind = cmd+shift+b=toggle_background_opacity

# Scrollback & screen export
keybind = cmd+shift+s=write_scrollback_file:paste
keybind = cmd+shift+c=copy_url_to_clipboard

