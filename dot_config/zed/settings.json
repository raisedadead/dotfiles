// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "astro": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "env": true,
    "html": true,
    "mcp-server-context7": true,
    "mdx": true,
    "nginx": true,
    "terraform": true,
    "toml": true,
    "wakatime": true,
    "zig": true,
  },
  "ui_font_size": 16,
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font"],
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "zero": true,
  },
  "buffer_font_size": 14,
  "tab_size": 2,
  "vim_mode": true,
  "preview_tabs": {
    "enabled": false,
  },
  "project_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
}
