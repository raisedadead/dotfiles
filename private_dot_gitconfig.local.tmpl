[user]
    name = Mrugesh Mohapatra
    email = noreply@mrugesh.dev
{{- if or (eq .chezmoi.os "darwin") (stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519_signing")) }}
    signingkey = ~/.ssh/id_ed25519_signing

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgSign = true
{{- end }}
