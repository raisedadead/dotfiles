#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat >&2 <<'EOF'
usage: op-fields --account <account> [--vault <vault>] <item>

Prints the fields of one 1Password item: section, label, type, whether a
value is set, and the op:// reference. It never prints a value.

  op-fields --account my.1password.com --vault Infra "Hetzner API"
EOF
	exit 64
}

account=""
vault=""
item=""
while (($#)); do
	case "$1" in
	--account) account="${2:-}" && shift 2 ;;
	--vault) vault="${2:-}" && shift 2 ;;
	-h | --help) usage ;;
	-*) usage ;;
	*) [[ -z "$item" ]] || usage && item="$1" && shift ;;
	esac
done
[[ -n "$account" && -n "$item" ]] || usage

args=(item get "$item" --account "$account" --format json)
[[ -z "$vault" ]] || args+=(--vault "$vault")

json="$(op "${args[@]}")"
printf 'section\tlabel\ttype\tvalue\treference\n'
jq -r '.fields[]? | [(.section.label // "-"), (.label // "-"), (.type // "-"), (if (.value // "") == "" then "empty" else "set" end), (.reference // "-")] | @tsv' <<<"$json"
