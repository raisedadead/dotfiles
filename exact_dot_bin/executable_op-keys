#!/usr/bin/env bun
import { parseArgs } from "node:util";

const ACCOUNTS = ["my.1password.com", "freecodecamp.1password.com"];
const DEFAULT_TIMEOUT_MS = 60_000;
const EXIT_OK = 0;
const EXIT_FAILED = 1;
const EXIT_USAGE = 64;
const WAITING_FOR_APPROVAL = "1Password is waiting for approval; approve it, then run this again";
const USAGE = `usage:
  op-keys find <words>...
  op-keys fields --account <account> [--vault <vault>] <item|id>

find lists the items of both accounts whose titles hold every word.
fields lists the fields of one item. It never prints a value.`;

type OpResult = { ok: true; stdout: string } | { ok: false; error: string };

interface ListedItem {
  id: string;
  title: string;
  category: string;
  vault: { name: string };
}

interface ItemField {
  label?: string;
  type?: string;
  value?: string;
  reference?: string;
  section?: { label?: string };
}

class UsageError extends Error {}

function timeoutMs(): number {
  return Number(process.env.OP_KEYS_TIMEOUT_MS) || DEFAULT_TIMEOUT_MS;
}

function firstLine(text: string): string {
  return text.split("\n").find((line) => line.trim()) ?? "";
}

async function runOp(args: string[]): Promise<OpResult> {
  const proc = Bun.spawn(["op", ...args], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
  const finished = Promise.all([
    new Response(proc.stdout).text(),
    new Response(proc.stderr).text(),
    proc.exited,
  ]);
  let timer: Timer | undefined;
  const expired = new Promise<"expired">((done) => {
    timer = setTimeout(() => done("expired"), timeoutMs());
  });
  const outcome = await Promise.race([finished, expired]);
  clearTimeout(timer);
  if (outcome === "expired") {
    proc.kill();
    return { ok: false, error: WAITING_FOR_APPROVAL };
  }
  const [stdout, stderr, code] = outcome;
  if (code !== 0) {
    return { ok: false, error: firstLine(stderr) || `op exited ${code}` };
  }
  return { ok: true, stdout };
}

function parseOpJson<T>(stdout: string): T | undefined {
  try {
    return JSON.parse(stdout) as T;
  } catch {
    return undefined;
  }
}

function strictArgs(args: string[], options: Record<string, { type: "string" }>) {
  try {
    return parseArgs({ args, options, allowPositionals: true, strict: true });
  } catch {
    throw new UsageError();
  }
}

async function listAccount(account: string): Promise<OpResult> {
  return runOp(["item", "list", "--account", account, "--format", "json"]);
}

function matchingRows(account: string, stdout: string, words: string[]): string[] | undefined {
  const items = parseOpJson<ListedItem[]>(stdout);
  if (!items) {
    return undefined;
  }
  return items
    .filter(({ title }) => words.every((word) => title.toLowerCase().includes(word)))
    .map(({ id, title, category, vault }) =>
      [account, vault.name, category, title, id].join("\t"),
    );
}

async function find(args: string[]): Promise<number> {
  const { positionals } = strictArgs(args, {});
  if (positionals.length === 0) {
    throw new UsageError();
  }
  const words = positionals.map((word) => word.toLowerCase());
  const results = await Promise.all(ACCOUNTS.map(listAccount));

  const rows: string[] = [];
  let failed = false;
  results.forEach((result, index) => {
    const account = ACCOUNTS[index];
    const matched = result.ok ? matchingRows(account, result.stdout, words) : undefined;
    if (matched) {
      rows.push(...matched);
      return;
    }
    failed = true;
    const reason = result.ok ? "op returned output that is not JSON" : result.error;
    console.error(`${account}: ${reason}`);
  });

  if (rows.length > 0) {
    console.log(["account\tvault\tcategory\ttitle\tid", ...rows].join("\n"));
  } else if (!failed) {
    console.log(`no item matches: ${positionals.join(" ")}`);
  }
  return failed ? EXIT_FAILED : EXIT_OK;
}

async function fields(args: string[]): Promise<number> {
  const { values, positionals } = strictArgs(args, {
    account: { type: "string" },
    vault: { type: "string" },
  });
  const { account, vault } = values;
  if (!account || positionals.length !== 1) {
    throw new UsageError();
  }
  const opArgs = ["item", "get", positionals[0], "--account", account, "--format", "json"];
  if (vault) {
    opArgs.push("--vault", vault);
  }
  const result = await runOp(opArgs);
  if (!result.ok) {
    console.error(result.error);
    return EXIT_FAILED;
  }
  const item = parseOpJson<{ fields?: ItemField[] }>(result.stdout);
  if (!item) {
    console.error("op returned output that is not JSON");
    return EXIT_FAILED;
  }
  const rows = (item.fields ?? []).map(({ section, label, type, value, reference }) =>
    [
      section?.label || "-",
      label || "-",
      type || "-",
      value ? "set" : "empty",
      reference || "-",
    ].join("\t"),
  );
  console.log(["section\tlabel\ttype\tvalue\treference", ...rows].join("\n"));
  return EXIT_OK;
}

async function main([command, ...args]: string[]): Promise<number> {
  try {
    switch (command) {
      case "find":
        return await find(args);
      case "fields":
        return await fields(args);
      default:
        throw new UsageError();
    }
  } catch (error) {
    if (error instanceof UsageError) {
      console.error(USAGE);
      return EXIT_USAGE;
    }
    throw error;
  }
}

process.exit(await main(Bun.argv.slice(2)));
