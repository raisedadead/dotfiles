#!/usr/bin/env bun
import { parseArgs } from "node:util";

const ACCOUNTS = ["my.1password.com", "freecodecamp.1password.com"];
const DEFAULT_TIMEOUT_MS = 60_000;
const EXIT_OK = 0;
const EXIT_FAILED = 1;
const EXIT_USAGE = 64;
const WAITING_FOR_APPROVAL = "1Password is waiting for approval; approve it, then run this again";
const EXIT_INTERRUPTED = 130;
const USAGE = `usage:
  op-keys find <words>...
  op-keys fields --account <account> [--vault <vault>] <item|id>
  op-keys new login|api --account <a> --vault <v> --title <t> [--notes <n>]
  op-keys new r2 --account <a> --vault <v> --title <t> --account-id <id> [--notes <n>]

find lists the items of both accounts whose titles hold every word.
fields lists the fields of one item. It never prints a value.
new creates an item from values typed at its prompts, so it needs a terminal.`;

type OpResult = { ok: true; stdout: string } | { ok: false; error: string };

interface FieldPrompt {
  label: string;
  templateField?: string;
  secret?: boolean;
  optional?: boolean;
}

interface ItemKind {
  template: string;
  prompts: FieldPrompt[];
}

interface ItemTemplate {
  title: string;
  fields: { id?: string; label?: string; type: string; value: string }[];
}

const KINDS = new Map<string, ItemKind>([
  [
    "login",
    {
      template: "Login",
      prompts: [
        { label: "username", templateField: "username" },
        { label: "password", templateField: "password", secret: true },
      ],
    },
  ],
  [
    "api",
    {
      template: "API Credential",
      prompts: [
        { label: "credential", templateField: "credential", secret: true },
        { label: "ID", templateField: "username", optional: true },
      ],
    },
  ],
  [
    "r2",
    {
      template: "API Credential",
      prompts: [
        { label: "Access Key ID", secret: true },
        { label: "Secret Access Key", secret: true },
        { label: "Token value", secret: true, optional: true },
      ],
    },
  ],
]);

interface ListedItem {
  id: string;
  title: string;
  category: string;
  vault: { name: string };
}

interface ItemField {
  label?: string;
  type?: string;
  value?: string;
  reference?: string;
  section?: { label?: string };
}

class UsageError extends Error {}

function timeoutMs(): number {
  return Number(process.env.OP_KEYS_TIMEOUT_MS) || DEFAULT_TIMEOUT_MS;
}

function firstLine(text: string): string {
  return text.split("\n").find((line) => line.trim()) ?? "";
}

async function runOp(args: string[]): Promise<OpResult> {
  const proc = Bun.spawn(["op", ...args], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
  const finished = Promise.all([
    new Response(proc.stdout).text(),
    new Response(proc.stderr).text(),
    proc.exited,
  ]);
  let timer: Timer | undefined;
  const expired = new Promise<"expired">((done) => {
    timer = setTimeout(() => done("expired"), timeoutMs());
  });
  const outcome = await Promise.race([finished, expired]);
  clearTimeout(timer);
  if (outcome === "expired") {
    proc.kill();
    return { ok: false, error: WAITING_FOR_APPROVAL };
  }
  const [stdout, stderr, code] = outcome;
  if (code !== 0) {
    return { ok: false, error: firstLine(stderr) || `op exited ${code}` };
  }
  return { ok: true, stdout };
}

function parseOpJson<T>(stdout: string): T | undefined {
  try {
    return JSON.parse(stdout) as T;
  } catch {
    return undefined;
  }
}

function strictArgs(args: string[], options: Record<string, { type: "string" }>) {
  try {
    return parseArgs({ args, options, allowPositionals: true, strict: true });
  } catch {
    throw new UsageError();
  }
}

async function listAccount(account: string): Promise<OpResult> {
  return runOp(["item", "list", "--account", account, "--format", "json"]);
}

function matchingRows(account: string, stdout: string, words: string[]): string[] | undefined {
  const items = parseOpJson<ListedItem[]>(stdout);
  if (!items) {
    return undefined;
  }
  return items
    .filter(({ title }) => words.every((word) => title.toLowerCase().includes(word)))
    .map(({ id, title, category, vault }) =>
      [account, vault.name, category, title, id].join("\t"),
    );
}

async function find(args: string[]): Promise<number> {
  const { positionals } = strictArgs(args, {});
  if (positionals.length === 0) {
    throw new UsageError();
  }
  const words = positionals.map((word) => word.toLowerCase());
  const results = await Promise.all(ACCOUNTS.map(listAccount));

  const rows: string[] = [];
  let failed = false;
  results.forEach((result, index) => {
    const account = ACCOUNTS[index];
    const matched = result.ok ? matchingRows(account, result.stdout, words) : undefined;
    if (matched) {
      rows.push(...matched);
      return;
    }
    failed = true;
    const reason = result.ok ? "op returned output that is not JSON" : result.error;
    console.error(`${account}: ${reason}`);
  });

  if (rows.length > 0) {
    console.log(["account\tvault\tcategory\ttitle\tid", ...rows].join("\n"));
  } else if (!failed) {
    console.log(`no item matches: ${positionals.join(" ")}`);
  }
  return failed ? EXIT_FAILED : EXIT_OK;
}

async function fields(args: string[]): Promise<number> {
  const { values, positionals } = strictArgs(args, {
    account: { type: "string" },
    vault: { type: "string" },
  });
  const { account, vault } = values;
  if (!account || positionals.length !== 1) {
    throw new UsageError();
  }
  const opArgs = ["item", "get", positionals[0], "--account", account, "--format", "json"];
  if (vault) {
    opArgs.push("--vault", vault);
  }
  const result = await runOp(opArgs);
  if (!result.ok) {
    console.error(result.error);
    return EXIT_FAILED;
  }
  const item = parseOpJson<{ fields?: ItemField[] }>(result.stdout);
  if (!item) {
    console.error("op returned output that is not JSON");
    return EXIT_FAILED;
  }
  const rows = (item.fields ?? []).map(({ section, label, type, value, reference }) =>
    [
      section?.label || "-",
      label || "-",
      type || "-",
      value ? "set" : "empty",
      reference || "-",
    ].join("\t"),
  );
  console.log(["section\tlabel\ttype\tvalue\treference", ...rows].join("\n"));
  return EXIT_OK;
}

function fail(message: string): number {
  console.error(message);
  return EXIT_FAILED;
}

async function createItem(
  account: string,
  vault: string,
  item: ItemTemplate,
): Promise<number> {
  const proc = Bun.spawn(
    ["op", "item", "create", "--account", account, "--vault", vault, "--format", "json", "-"],
    { stdin: Buffer.from(JSON.stringify(item)), stdout: "ignore", stderr: "pipe" },
  );
  process.on("SIGINT", () => {
    proc.kill();
    console.error(
      `create was interrupted, so the outcome is unknown; run: op-keys find ${item.title}`,
    );
    process.exit(EXIT_INTERRUPTED);
  });
  const [stderr, code] = await Promise.all([new Response(proc.stderr).text(), proc.exited]);
  if (code !== 0) {
    return fail(firstLine(stderr) || `op exited ${code}`);
  }
  console.log(`created ${item.title} in ${vault}`);
  return EXIT_OK;
}

async function newItem(args: string[]): Promise<number> {
  const { values, positionals } = strictArgs(args, {
    account: { type: "string" },
    vault: { type: "string" },
    title: { type: "string" },
    notes: { type: "string" },
    "account-id": { type: "string" },
  });
  const [kindName, ...extra] = positionals;
  const kind = KINDS.get(kindName);
  const { account, vault, title, notes, "account-id": accountId } = values;
  const accountIdFits = (kindName === "r2") === Boolean(accountId);
  if (!kind || extra.length > 0 || !account || !vault || !title || !accountIdFits) {
    throw new UsageError();
  }
  if (!process.stdin.isTTY) {
    return fail("op-keys new needs a terminal; open it in a popup");
  }

  const templateResult = await runOp([
    "item", "template", "get", kind.template, "--account", account, "--format", "json",
  ]);
  if (!templateResult.ok) {
    return fail(templateResult.error);
  }
  const template = parseOpJson<ItemTemplate>(templateResult.stdout);
  if (!template) {
    return fail("op returned a template that is not JSON");
  }
  const lostField = kind.prompts.find(
    ({ templateField }) =>
      templateField && !template.fields.some(({ id }) => id === templateField),
  );
  if (lostField) {
    return fail(`the ${kind.template} template has no ${lostField.templateField} field`);
  }

  const listResult = await runOp([
    "item", "list", "--account", account, "--vault", vault, "--format", "json",
  ]);
  if (!listResult.ok) {
    return fail(listResult.error);
  }
  const existing = parseOpJson<ListedItem[]>(listResult.stdout);
  if (!existing) {
    return fail("op returned an item list that is not JSON");
  }
  if (existing.some((item) => item.title === title)) {
    return fail(`${title} already exists in ${vault} on ${account}`);
  }

  const { confirm, isCancel, note, password, text } = await import("@clack/prompts@1.8.1");
  const typed = new Map<FieldPrompt, string>();
  for (const prompt of kind.prompts) {
    const { label, secret, optional } = prompt;
    const ask = secret ? password : text;
    const answer = await ask({
      message: optional ? `${label} (optional)` : label,
      validate: optional ? undefined : (value) => (value ? undefined : `${label} is required`),
    });
    if (isCancel(answer)) {
      return fail("cancelled, nothing created");
    }
    if (answer) {
      typed.set(prompt, answer);
    }
  }

  const fieldsToSend = template.fields.map((field) => ({ ...field }));
  const customFields: ItemTemplate["fields"] = [];
  for (const [{ label, templateField }, value] of typed) {
    const target = fieldsToSend.find(({ id }) => id === templateField);
    if (target) {
      target.value = value;
    } else {
      customFields.push({ label, type: "CONCEALED", value });
    }
  }
  if (accountId) {
    customFields.push({
      label: "Endpoint",
      type: "URL",
      value: `https://${accountId}.r2.cloudflarestorage.com`,
    });
  }
  const notesField = fieldsToSend.find(({ id }) => id === "notesPlain");
  if (notes && notesField) {
    notesField.value = notes;
  }
  const item: ItemTemplate = {
    ...template,
    title,
    fields: [...fieldsToSend.filter(({ value }) => value), ...customFields],
  };

  const fieldNames = item.fields.map(({ id, label }) => label ?? id).join(", ");
  note(
    `account: ${account}\nvault: ${vault}\ntitle: ${title}\nfields: ${fieldNames}`,
    "New item",
  );
  const approved = await confirm({ message: "Create this item?", initialValue: false });
  if (isCancel(approved) || !approved) {
    return fail("nothing created");
  }
  console.log("creating the item");
  return createItem(account, vault, item);
}

async function main([command, ...args]: string[]): Promise<number> {
  try {
    switch (command) {
      case "find":
        return await find(args);
      case "fields":
        return await fields(args);
      case "new":
        return await newItem(args);
      default:
        throw new UsageError();
    }
  } catch (error) {
    if (error instanceof UsageError) {
      console.error(USAGE);
      return EXIT_USAGE;
    }
    throw error;
  }
}

process.exit(await main(Bun.argv.slice(2)));
