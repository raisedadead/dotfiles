#!/usr/bin/env -S bun --no-env-file --config=/dev/null
import {
  accessSync,
  closeSync,
  constants,
  existsSync,
  lstatSync,
  mkdirSync,
  mkdtempSync,
  openSync,
  readdirSync,
  readFileSync,
  readlinkSync,
  renameSync,
  rmSync,
  statSync,
  writeFileSync,
  writeSync,
} from "node:fs";
import { homedir, tmpdir } from "node:os";
import { isatty } from "node:tty";

const HELP = [
  "# chezmoi-claude-doctor — detect drift in ~/.claude/ vs chezmoi sources.",
  "# Exits 1 on any issue. No allowlist file: pure shape + coverage.",
  "#",
  "# Five checks:",
  "#   1. chezmoi status   — managed files modified in place (drift in source-tracked content).",
  "#   2. coverage         — files inside managed top-level dirs that aren't themselves managed",
  "#                         (catches external installers dropping files into ~/.claude/agents/, etc.).",
  "#   3. shape filter     — unmanaged top-level config-shape files (*.md/.toml/.yaml/.yml/.kdl/.ini)",
  "#                         (catches hand-edited orphan docs like the original RTK.md case).",
  "#   4. mcp drift        — settings.json.mcpServers (canonical) vs ~/.claude.json (runtime),",
  "#                         compared on .mcpServers, plus a 0600 mode check.",
  "#   5. lint             — schema-shape checks:",
  "#                           5a. enabledPlugins values must be boolean (array form silently disables in CC 2.1.x).",
  "#                           5b. mcpServers entries must declare `type` (stdio/http/sse).",
  "#                           5c. log `claude --version` informationally (no pin — operator policy 2026-05-15).",
  "#                           5d. SKILL.md frontmatter `name:` must match parent directory.",
  "#                           5e. skill layers: ~/.claude/skills links resolve into ../../.agents/skills/<name>,",
  "#                               symlink_<name> source entries match a dot_agents/skills/<name>, and no",
  "#                               common skill is also a CLI-installed copy (skills lock).",
  "#",
  "# Usage:",
  "#   chezmoi-claude-doctor           # report + non-zero exit on drift",
  "#   chezmoi-claude-doctor --quiet   # exit code only",
  "#   chezmoi-claude-doctor --rewake  # hook mode: issues on stderr with exit 2; WARN lines to ~/.claude/markers/doctor-warnings.txt",
].join("\n");

type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

type State = {
  home: string;
  claudeDir: string;
  pubSource: string;
  privSource: string;
  shapeExts: string;
  cavemem: string;
  codexReleases: string;
  piReleases: string;
  additionsFile: string;
  ownPluginSrc: string;
  quiet: boolean;
  managed: string[];
  managedSet: Set<string>;
  ignored: string[];
  sink: string[] | null;
  errTo: "stderr" | "sink" | "drop";
};

class Exit {
  constructor(readonly code: number) {}
}

const env = (name: string) => process.env[name] ?? "";
const HOME = env("HOME") || homedir();
const PUB = env("PUB_SOURCE") || `${HOME}/.dotfiles`;

const S: State = {
  home: HOME,
  claudeDir: env("CLAUDE_DIR") || `${HOME}/.claude`,
  pubSource: PUB,
  privSource: env("PRIV_SOURCE") || `${HOME}/.dotfiles`,
  shapeExts: env("SHAPE_EXTS") || "md|toml|yaml|yml|kdl|ini",
  cavemem: env("CAVEMEM_HEALTH") || `${HOME}/.bin/cavemem-health.sh`,
  codexReleases: env("CODEX_RELEASES") || `${HOME}/.codex/packages/app-server-daemon/releases`,
  piReleases: env("PI_RELEASES") || `${HOME}/.pi/agent/install/releases`,
  additionsFile: env("ADDITIONS_FILE") || `${PUB}/docs/agent-additions.txt`,
  ownPluginSrc: env("OWN_PLUGIN_SRC"),
  quiet: false,
  managed: [],
  managedSet: new Set(),
  ignored: [],
  sink: null,
  errTo: "stderr",
};

function capture(fn: () => unknown): string {
  const saved = S.sink;
  const lines: string[] = [];
  S.sink = lines;
  try {
    fn();
  } finally {
    S.sink = saved;
  }
  return chomp(lines.join("\n"));
}

function log(line: string) {
  if (S.quiet) return;
  if (S.sink) S.sink.push(line);
  else writeSync(1, `${line}\n`);
}

function err(line: string) {
  if (S.errTo === "drop") return;
  if (S.errTo === "sink" && S.sink) S.sink.push(line);
  else writeSync(2, `${line}\n`);
}

function firstField(text: string): string {
  return chomp(
    lines(text)
      .map(line => line.replace(/^[ \t]+/, "").split(/[ \t]+/)[0])
      .join("\n"),
  );
}

function chomp(text: string): string {
  return text.replace(/\n+$/, "");
}

function lines(text: string): string[] {
  return text === "" ? [] : chomp(text).split("\n");
}

function readLines(text: string): string[] {
  const all = text.split("\n");
  all.pop();
  return all;
}

function read(path: string): string | undefined {
  try {
    return readFileSync(path, "utf8");
  } catch {
    return undefined;
  }
}

function access(path: string, mode: number): boolean {
  try {
    accessSync(path, mode);
    return true;
  } catch {
    return false;
  }
}

const readable = (path: string) => access(path, constants.R_OK);
const executable = (path: string) => access(path, constants.X_OK);

function stat(path: string) {
  try {
    return statSync(path);
  } catch {
    return undefined;
  }
}

function lstat(path: string) {
  try {
    return lstatSync(path);
  } catch {
    return undefined;
  }
}

const isDir = (path: string) => stat(path)?.isDirectory() ?? false;
const isFile = (path: string) => stat(path)?.isFile() ?? false;
const isLink = (path: string) => lstat(path)?.isSymbolicLink() ?? false;

function readlink(path: string): string {
  try {
    return readlinkSync(path);
  } catch {
    return "";
  }
}

function names(dir: string): string[] {
  try {
    return readdirSync(dir);
  } catch {
    return [];
  }
}

function children(dir: string): string[] {
  if (!lstat(dir)?.isDirectory()) return [];
  return names(dir).map(name => `${dir}/${name}`);
}

function walk(dir: string, max = Infinity, depth = 1, out: { path: string; depth: number }[] = []) {
  for (const path of children(dir)) {
    out.push({ path, depth });
    if (depth < max) walk(path, max, depth + 1, out);
  }
  return out;
}

const kind = (path: string) => lstat(path);

function tilde(path: string): string {
  return path.startsWith(S.home) ? `~${path.slice(S.home.length)}` : path;
}

function relHome(path: string): string {
  return path.startsWith(`${S.home}/`) ? path.slice(S.home.length + 1) : path;
}

function which(name: string): boolean {
  return Bun.which(name) !== null;
}

type Ran = { code: number; out: string };

function sh(argv: string[], opts: { cwd?: string; input?: string | Uint8Array; pass?: boolean } = {}): Ran {
  const mode = !opts.pass || S.errTo === "drop" ? "ignore" : S.errTo === "sink" && S.sink ? "pipe" : "inherit";
  try {
    const proc = Bun.spawnSync(argv, {
      cwd: opts.cwd,
      env: process.env,
      stdin: opts.input === undefined ? "ignore" : typeof opts.input === "string" ? Buffer.from(opts.input) : opts.input,
      stdout: "pipe",
      stderr: mode,
    });
    if (mode === "pipe" && proc.stderr) for (const line of lines(proc.stderr.toString())) err(line);
    return { code: proc.exitCode ?? 1, out: proc.stdout.toString() };
  } catch {
    return { code: 127, out: "" };
  }
}

function sortUnique(text: string): string {
  if (text === "") return "";
  return sh(["sort", "-u"], { input: text.endsWith("\n") ? text : `${text}\n` }).out;
}

function git(dir: string, ...args: string[]): Ran {
  return sh(["git", "-C", dir, ...args]);
}

function gitCommonDir(dir: string): string {
  return chomp(git(dir, "rev-parse", "--path-format=absolute", "--git-common-dir").out);
}

function rewakeApplies(dir: string): boolean {
  if (!dir) return false;
  const here = gitCommonDir(dir);
  if (!here) return false;
  for (const src of [S.pubSource, S.privSource]) {
    const root = gitCommonDir(src);
    if (!root) continue;
    if (here === root || here.startsWith(`${root}/`)) return true;
  }
  return false;
}

async function readStdin(ms: number): Promise<string> {
  if (isatty(0)) return "";
  const chunks: Uint8Array[] = [];
  try {
    const reader = Bun.stdin.stream().getReader();
    const timeout = Bun.sleep(ms).then(() => null);
    for (;;) {
      const next = await Promise.race([reader.read(), timeout]);
      if (next === null || next.done) break;
      chunks.push(next.value);
    }
  } catch {}
  return Buffer.concat(chunks).toString().split("\0")[0];
}

async function sessionCwd(): Promise<string> {
  const payload = await readStdin(1000);
  let cwd = "";
  if (payload) {
    try {
      cwd = chomp(
        parseStream(payload)
          .map(value => get(value, "cwd"))
          .filter(value => value !== null && value !== false)
          .map(raw)
          .join("\n"),
      );
    } catch {
      cwd = "";
    }
  }
  if (cwd) return cwd;
  try {
    return process.cwd();
  } catch {
    return env("PWD");
  }
}

function parseStream(text: string): Json[] {
  if (text.trim() === "") return [];
  return [JSON.parse(text) as Json];
}

function readJson(path: string): Json[] {
  const text = read(path);
  if (text === undefined) throw new Error(`unreadable ${path}`);
  return parseStream(text);
}

function isObject(value: Json | undefined): value is { [key: string]: Json } {
  return value !== null && typeof value === "object" && !Array.isArray(value);
}

function get(value: Json, key: string): Json {
  if (value === null) return null;
  if (isObject(value)) return Object.hasOwn(value, key) ? value[key] : null;
  throw new Error(`cannot index ${typeof value} with ${key}`);
}

function first0(value: Json): Json {
  if (value === null) return null;
  if (Array.isArray(value)) return value[0] ?? null;
  throw new Error("cannot index with 0");
}

function alt(value: Json, fallback: Json): Json {
  return value === null || value === false ? fallback : value;
}

function altLazy(...options: (() => Json)[]): Json {
  for (const option of options) {
    const value = option();
    if (value !== null && value !== false) return value;
  }
  return null;
}

function keys(value: Json): Json[] {
  if (Array.isArray(value)) return value.map((_, at) => at);
  if (isObject(value)) return Object.keys(value).sort();
  throw new Error("value has no keys");
}

function entries(value: Json): [Json, Json][] {
  if (Array.isArray(value)) return value.map((item, at) => [at, item]);
  if (isObject(value)) return Object.entries(value);
  throw new Error("value has no keys");
}

function values(value: Json): Json[] {
  if (Array.isArray(value)) return value;
  if (isObject(value)) return Object.values(value);
  throw new Error("cannot iterate");
}

function valuesTry(value: Json): Json[] {
  return Array.isArray(value) || isObject(value) ? values(value) : [];
}

function equal(a: Json, b: Json): boolean {
  if (a === b) return true;
  if (Array.isArray(a)) return Array.isArray(b) && a.length === b.length && a.every((item, at) => equal(item, b[at]));
  if (isObject(a) && isObject(b)) {
    const left = Object.keys(a);
    return left.length === Object.keys(b).length && left.every(key => Object.hasOwn(b, key) && equal(a[key], b[key]));
  }
  return false;
}

function minus(a: Json, b: Json): Json[] {
  if (!Array.isArray(a) || !Array.isArray(b)) throw new Error("cannot be subtracted");
  return a.filter(item => !b.some(other => equal(item, other)));
}

function quote(text: string): string {
  return JSON.stringify(text).replace(/\x7f/g, "\\u007f");
}

function compact(value: Json): string {
  if (Array.isArray(value)) return `[${value.map(compact).join(",")}]`;
  if (isObject(value)) return `{${Object.keys(value).map(key => `${quote(key)}:${compact(value[key])}`).join(",")}}`;
  return typeof value === "string" ? quote(value) : JSON.stringify(value);
}

function pretty(value: Json, sorted: boolean, pad = ""): string {
  const inner = `${pad}  `;
  if (Array.isArray(value)) {
    if (!value.length) return "[]";
    return `[\n${value.map(item => inner + pretty(item, sorted, inner)).join(",\n")}\n${pad}]`;
  }
  if (isObject(value)) {
    const all = Object.keys(value);
    if (sorted) all.sort();
    if (!all.length) return "{}";
    return `{\n${all.map(key => `${inner}${quote(key)}: ${pretty(value[key], sorted, inner)}`).join(",\n")}\n${pad}}`;
  }
  return typeof value === "string" ? quote(value) : JSON.stringify(value);
}

function interp(value: Json): string {
  return typeof value === "string" ? value : compact(value);
}

function raw(value: Json): string {
  return typeof value === "string" ? value : pretty(value, false);
}

function globRegex(pattern: string): string {
  let out = "";
  for (let at = 0; at < pattern.length; at++) {
    const ch = pattern[at];
    if (ch === "*") out += ".*";
    else if (ch === "?") out += ".";
    else if (ch === "\\" && at + 1 < pattern.length) out += escape(pattern[++at]);
    else if (ch === "[") {
      const close = pattern.indexOf("]", at + (pattern[at + 1] === "!" || pattern[at + 1] === "^" ? 3 : 2));
      if (close < 0) {
        out += "\\[";
        continue;
      }
      let body = pattern.slice(at + 1, close);
      if (body.startsWith("!")) body = `^${body.slice(1)}`;
      out += `[${body.replace(/\\/g, "\\\\")}]`;
      at = close;
    } else out += escape(ch);
  }
  return out;
}

function escape(text: string): string {
  return text.replace(/[.*+?^${}()|[\]\\/]/g, "\\$&");
}

function globMatch(path: string, pattern: string): boolean {
  try {
    return new RegExp(`^${globRegex(pattern)}$`, "s").test(path);
  } catch {
    return false;
  }
}

function buildManaged(): string[] {
  if (!isDir(S.pubSource)) return [];
  const text = sortUnique(sh(["chezmoi", "managed", "--source", S.pubSource, "--path-style", "absolute"]).out);
  return text === "" ? [] : readLines(text);
}

function setManaged(list: string[]) {
  S.managed = list;
  S.managedSet = new Set(list);
}

function loadIgnored() {
  S.ignored = [];
  const path = `${S.privSource}/.chezmoiignore`;
  if (!readable(path)) return;
  for (let line of readLines(read(path) ?? "")) {
    line = line.split("#")[0].replace(/^[ \t\n\r\f\v]+/, "").replace(/[ \t\n\r\f\v]+$/, "");
    if (!line || line.startsWith("!")) continue;
    if (!line.startsWith(".claude/")) continue;
    S.ignored.push(`${S.home}/${line}`);
  }
}

function isIgnored(path: string): boolean {
  for (const pat of S.ignored) {
    if (!pat) continue;
    if (path === pat) return true;
    if (isDir(pat) && path.startsWith(`${pat}/`)) return true;
    if (pat.includes("/**/")) {
      const prefix = pat.slice(0, pat.indexOf("/**/"));
      const suffix = pat.slice(pat.lastIndexOf("/**/") + 4);
      const literal = path.startsWith(`${prefix}/`) && path.endsWith(suffix) && path.length >= prefix.length + 1 + suffix.length;
      if (literal || globMatch(path, `${prefix.replace(/[*?[\\]/g, "\\$&")}/*/${suffix}`)) return true;
    }
    if (pat.endsWith("/**") && path.startsWith(`${pat.slice(0, -3)}/`)) return true;
    if (pat.includes("*") && !pat.includes("**") && globMatch(path, pat)) return true;
  }
  return false;
}

const isManaged = (path: string) => S.managedSet.has(path);

function topLevelManaged(): string[] {
  const prefix = `${S.claudeDir}/`;
  const tops = S.managed.filter(path => path.startsWith(prefix)).map(path => prefix + path.slice(prefix.length).split("/")[0]);
  return readLines(sortUnique(tops.length ? `${tops.join("\n")}\n` : ""));
}

function checkStatus(): number {
  let out = "";
  if (isDir(S.pubSource)) {
    const status = sh(["chezmoi", "status", "--source", S.pubSource, "--path-style", "absolute", "--", S.claudeDir]);
    if (status.code !== 0) {
      log("  ERROR: chezmoi status failed");
      return 1;
    }
    out = chomp(sortUnique(status.out));
  }
  if (out) {
    log(out);
    return out.split("\n").length;
  }
  log("  clean");
  return 0;
}

function checkCoverage(): number {
  let found = 0;
  for (const dir of topLevelManaged()) {
    if (!isDir(dir) || isLink(dir)) continue;
    for (const { path } of walk(dir)) {
      if (!kind(path)?.isFile()) continue;
      if (isManaged(path) || isIgnored(path)) continue;
      log(`  ORPHAN: ${path}`);
      found++;
    }
  }
  if (found === 0) log("  clean");
  return found;
}

function checkShape(): number {
  let found = 0;
  let shape: RegExp;
  try {
    shape = new RegExp(`^.*\\.(${S.shapeExts})$`, "s");
  } catch {
    shape = /$^/;
  }
  for (const path of children(S.claudeDir)) {
    if (!kind(path)?.isFile() || !shape.test(path)) continue;
    if (isManaged(path) || isIgnored(path)) continue;
    log(`  ORPHAN: ${path}`);
    found++;
  }
  if (found === 0) log("  clean");
  return found;
}

function withTemp<T>(prefix: string, fn: (dir: string) => T): T {
  const dir = mkdtempSync(`${tmpdir()}/${prefix}`);
  try {
    return fn(dir);
  } finally {
    rmSync(dir, { recursive: true, force: true });
  }
}

function checkMcp(): number {
  const settings = `${S.privSource}/dot_claude/.settings.managed.json`;
  const runtime = `${S.home}/.claude.json`;
  let found = 0;
  if (!readable(settings)) {
    log("  skip (dot_claude/.settings.managed.json unreadable)");
    return 0;
  }
  if (!readable(runtime)) {
    log("  DRIFT: ~/.claude.json is absent or unreadable");
    return 1;
  }
  let source: Json[];
  try {
    source = readJson(settings);
  } catch {
    log("  LINT: dot_claude/.settings.managed.json is not valid JSON");
    return 1;
  }
  const mode = stat(runtime);
  const bits = mode ? (mode.mode & 0o777).toString(8) : "";
  if (bits !== "600") {
    log(`  DRIFT: ~/.claude.json mode is ${bits || "unknown"}, not 600`);
    found++;
  }
  let canonical: string;
  try {
    const servers = source.map(value => get(value, "mcpServers"));
    const last = servers.at(-1);
    if (last === undefined || last === null || last === false) throw new Error("no mcpServers");
    canonical = servers.map(value => pretty(value, true)).join("\n");
  } catch {
    log("  skip (settings.json declares no mcpServers; apply is a passthrough)");
    return found;
  }
  let live: string;
  try {
    live = readJson(runtime)
      .map(value => pretty(alt(get(value, "mcpServers"), {}), true))
      .join("\n");
  } catch {
    log("  LINT: ~/.claude.json is not valid JSON");
    return found + 1;
  }
  if (canonical === live) {
    if (found === 0) log("  clean");
    return found;
  }
  log("  DRIFT in mcpServers (dot_claude/.settings.managed.json is canonical)");
  let diff = "";
  attempt(() => {
    diff = withTemp("chezmoi-claude-doctor.", dir => {
      writeFileSync(`${dir}/live`, `${live}\n`);
      writeFileSync(`${dir}/canonical`, `${canonical}\n`);
      return sh(["diff", "-u", "--label", ".claude.json", "--label", "settings.json", `${dir}/live`, `${dir}/canonical`], { pass: true }).out;
    });
  });
  for (const line of chomp(diff).split("\n")) log(`  ${line}`);
  return found + 1;
}

function jqLines(fn: () => Json[]): string[] {
  try {
    return fn()
      .map(interp)
      .join("\n")
      .split("\n")
      .filter(Boolean);
  } catch {
    return [];
  }
}

function frontmatterName(text: string): string {
  let inside = false;
  for (const line of text.split("\n")) {
    if (/^---[ \t\n\r\f\v]*$/.test(line)) {
      inside = !inside;
      continue;
    }
    if (inside && line.startsWith("name:")) return line.replace(/^name:[ \t\n\r\f\v]*/, "").replace(/["']/g, "");
  }
  return "";
}

function checkLint(): number {
  const settings = `${S.privSource}/dot_claude/.settings.managed.json`;
  let found = 0;
  if (readable(settings)) {
    let source: Json[] = [];
    try {
      source = readJson(settings);
    } catch {
      source = [];
    }
    for (const plugin of jqLines(() =>
      source.flatMap(value => entries(alt(get(value, "enabledPlugins"), {})).filter(([, flag]) => typeof flag !== "boolean").map(([key]) => key)),
    )) {
      log(`  LINT: enabledPlugins[${plugin}] is not boolean (CC 2.1.x silently disables array form)`);
      found++;
    }
    for (const server of jqLines(() =>
      source.flatMap(value =>
        entries(alt(get(value, "mcpServers"), {}))
          .filter(([, entry]) => isObject(entry) && !Object.hasOwn(entry, "type"))
          .map(([key]) => key),
      ),
    )) {
      log(`  LINT: mcpServers[${server}] missing 'type' field (stdio/http/sse)`);
      found++;
    }
  }

  if (which("claude")) {
    const version = firstField(sh(["claude", "--version"]).out);
    if (version) log(`  INFO: claude --version=${version} (informational)`);
  }

  for (const root of [`${S.privSource}/dot_claude/skills`, `${S.privSource}/dot_agents/skills`]) {
    if (!isDir(root)) continue;
    for (const dir of children(root)) {
      if (!kind(dir)?.isDirectory()) continue;
      const skill = `${dir}/SKILL.md`;
      if (!readable(skill)) continue;
      const name = frontmatterName(read(skill) ?? "");
      const base = dir.slice(dir.lastIndexOf("/") + 1);
      if (name && name !== base) {
        log(`  LINT: skill frontmatter name='${name}' != dir='${base}' (${skill})`);
        found++;
      }
    }
  }

  const common = `${S.privSource}/dot_agents/skills`;
  const state = env("XDG_STATE_HOME");
  const lock = state ? `${state}/skills/.skill-lock.json` : `${S.home}/.agents/.skill-lock.json`;
  for (const path of children(`${S.claudeDir}/skills`)) {
    if (!isLink(path)) continue;
    const name = path.slice(path.lastIndexOf("/") + 1);
    const target = readlink(path);
    if (!existsSync(path)) {
      log(`  LINT: skill link ${path} is dangling`);
      found++;
    } else if (target !== `../../.agents/skills/${name}`) {
      log(`  LINT: skill link ${path} targets '${target}', not '../../.agents/skills/${name}'`);
      found++;
    }
  }
  for (const entry of children(`${S.privSource}/dot_claude/skills`)) {
    const file = entry.slice(entry.lastIndexOf("/") + 1);
    if (!kind(entry)?.isFile() || !file.startsWith("symlink_")) continue;
    const name = file.slice("symlink_".length);
    const target = chomp(read(entry) ?? "");
    if (target !== `../../.agents/skills/${name}`) {
      log(`  LINT: ${entry} holds '${target}', not '../../.agents/skills/${name}'`);
      found++;
    }
    if (!readable(`${common}/${name}/SKILL.md`)) {
      log(`  LINT: ${entry} has no ${common}/${name}/SKILL.md`);
      found++;
    }
  }
  if (isDir(common) && readable(lock)) {
    let skills: Json = null;
    try {
      skills = get(readJson(lock)[0] ?? null, "skills");
    } catch {
      skills = null;
    }
    for (const dir of children(common)) {
      if (!kind(dir)?.isDirectory()) continue;
      const name = dir.slice(dir.lastIndexOf("/") + 1);
      if (isObject(skills) && Object.hasOwn(skills, name)) {
        log(`  LINT: common skill '${name}' is also a CLI-installed copy (${lock})`);
        found++;
      }
    }
  }

  if (found === 0) log("  clean");
  return found;
}

function checkPluginSrcDrift(): number {
  const installed = `${S.claudeDir}/plugins/installed_plugins.json`;
  if (!readable(installed)) {
    log("  skip (installed_plugins.json missing)");
    return 0;
  }
  let data: Json = null;
  let plugins: string[] = [];
  try {
    data = readJson(installed)[0] ?? null;
    plugins = jqLines(() => keys(get(data, "plugins")));
  } catch {
    plugins = [];
  }
  if (!plugins.length) {
    log("  clean");
    return 0;
  }
  const own = S.ownPluginSrc || `${S.home}/DEV/rd/claude-code-plugins`;
  const hasGit = isDir(`${own}/.git`);
  let main = "";
  if (hasGit) {
    const head = git(own, "rev-parse", "--verify", "-q", "origin/main^{commit}");
    if (head.code !== 0) {
      log(`  note: ${own} has no origin/main — fetch it to compare the installs`);
      return 0;
    }
    main = chomp(head.out);
  }
  let found = 0;
  for (const key of plugins) {
    if (!key.endsWith("@raisedadead-plugins") || !hasGit) continue;
    let sha = "";
    try {
      const first = get(get(data, "plugins"), key);
      sha = chomp(raw(alt(get(first0(first), "gitCommitSha"), "")));
    } catch {
      sha = "";
    }
    if (!sha) continue;
    if (git(own, "cat-file", "-e", `${sha}^{commit}`).code !== 0) {
      log(`  note: ${key} installed ${sha.slice(0, 12)} is not in ${own} — fetch to compare it with origin/main`);
      continue;
    }
    if (git(own, "merge-base", "--is-ancestor", main, sha).code === 0) continue;
    const name = key.replace(/@[^@]*$/, "");
    const rc = sh(["git", "-C", own, "diff", "--quiet", sha, main, "--", `plugins/${name}`, `:(exclude)plugins/${name}/CHANGELOG.md`], { pass: true }).code;
    if (rc === 0) continue;
    if (rc !== 1) {
      log(`  note: ${key} git diff exited ${rc} in ${own}`);
      continue;
    }
    log(`  WARN: ${key} installed ${sha.slice(0, 12)} differs from plugins/${name} on origin/main (${main.slice(0, 12)}) — run /cmd-refresh-plugins`);
    found++;
  }
  if (found === 0) log("  clean");
  return found;
}

