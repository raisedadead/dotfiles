function piManaged(path: string): string {
  const text = read(path);
  if (text === undefined) return "";
  const picked: string[] = [];
  let inside = false;
  for (const line of lines(text)) {
    if (!inside) {
      if (/^managed='\{/.test(line)) {
        inside = true;
        picked.push(line);
      }
      continue;
    }
    picked.push(line);
    if (/^\}'/.test(line)) inside = false;
  }
  return chomp(picked.map(line => line.replace(/^managed='/, "").replace(/^\}'/, "}")).join("\n"));
}

