  });
  for (const name of readLines(servers)) {
    const pattern = new RegExp(`"${escape(name)}"[ \\t\\r\\f\\v]*:[ \\t\\r\\f\\v]*\\{`);
    if (template !== undefined && template.split("\n").some(line => pattern.test(line))) continue;
    out += `pi-mcp ${name}\n`;
  }
  return out;
}

const SPACE = "[ \\t\\n\\r\\f\\v]";

function codexSectionItems(normal: string[], section: string, label: string): string {
  const pattern = new RegExp(`^\\[${section}\\.("([^"]+)"|'([^']+)'|([^\\].\"']+))\\]$`);
  let out = "";
  for (const line of normal) {
    const match = pattern.exec(line);
    if (match) out += `${label} ${match[2] ?? ""}${match[3] ?? ""}${match[4] ?? ""}\n`;
  }
  return out;
}

function codexNotify(normal: string[]): string {
  const picked: string[] = [];
  let inside = false;
  for (const line of normal) {
    if (!inside) {
      if (new RegExp(`^notify${SPACE}*=`).test(line)) {
        inside = true;
        picked.push(line);
      }
      continue;
    }
    picked.push(line);
    if (line.includes("]")) inside = false;
  }
  return picked
    .join("")
    .replace(/'/g, '"')
    .replace(/^[^[]*\[/, "")
    .replace(/\][^\]]*$/, "")
    .replace(new RegExp(`,${SPACE}*$`), "")
    .replace(new RegExp(`${SPACE}*,${SPACE}*`, "g"), ", ")
    .replace(new RegExp(`^${SPACE}+`), "");
}

function listCodexAdditions(): string {
  const codex = `${S.home}/.codex`;
  const config = `${codex}/config.toml`;
  let out = "";
  if (readable(config)) {
    const text = read(config) ?? "";
    const normal = lines(
      chomp(
        (text.endsWith("\n") ? text.slice(0, -1) : text)
          .split("\n")
          .map(line =>
            line
              .replace(new RegExp(`^${SPACE}+`), "")
              .replace(new RegExp(`^(\\[[^#]*\\])${SPACE}*#.*$`, "s"), "$1")
              .replace(new RegExp(`${SPACE}+$`), ""),
          )
          .join("\n"),
      ),
    );
    out += codexSectionItems(normal, "marketplaces", "codex-marketplace");
    out += codexSectionItems(normal, "mcp_servers", "codex-mcp");
    out += codexSectionItems(normal, "plugins", "codex-plugin");
    out += codexSectionItems(normal, "agents", "codex-agent");
    if (normal.some(line => /^\[\[?hooks[\].]/.test(line))) out += "codex-hooks config\n";
    const notify = codexNotify(normal);
    if (notify) out += `codex-notify ${notify}\n`;
  }
  for (const name of ["AGENTS.md", "AGENTS.override.md"]) {
    if (existsSync(`${codex}/${name}`)) out += `codex-instructions ${name}\n`;
  }
  if (existsSync(`${codex}/hooks.json`)) out += "codex-hooks hooks.json\n";
  for (const name of ["skills", "rules", "agents"]) out += listUnmanagedChildren(`codex-${name}`, `${codex}/${name}`);
  return out;
}

function checkAdditions(): boolean {
  let reason = "";
  if (!readable(`${S.privSource}/dot_claude/.settings.managed.json`)) reason = "dot_claude/.settings.managed.json unreadable";
  if (!S.managed.length) reason = "chezmoi managed list empty";
  if (reason) {
    log(`  WARN: agent addition: check skipped (${reason})`);
    return false;
  }
  const text = [
    listClaudeAdditions(),
    listChangedInstructions(),
    listUnmanagedChildren("shared-skills", `${S.home}/.agents/skills`, `${S.pubSource}/docs/skills.tsv`),
    listPiAdditions(),
    listCodexAdditions(),
  ].join("");
  const approvedText = read(S.additionsFile);
  const approved = new Set(approvedText === undefined ? [] : approvedText.split("\n"));
  let found = 0;
  for (const item of readLines(sortUnique(text.replace(/[^\x20-\x7e\n]/g, "")))) {
    if (!item || approved.has(item)) continue;
    log(`  WARN: agent addition: ${item} - remove it, or add this item to docs/agent-additions.txt`);
    found++;
  }
  if (found === 0) log("  clean");
  return found === 0;
}

function checkSubmodule() {
  const status = chomp(git(S.privSource, "submodule", "status", "dot_claude").out);
  if (status === "" || status.startsWith("-")) {
    err(`dot_claude submodule not initialised: git -C ${S.privSource} submodule update --init`);
    throw new Exit(2);
  }
  if (status.startsWith("+")) log(`WARN: dot_claude checkout differs from the recorded gitlink; commit the bump in ${S.privSource}`);
  if (!isFile(`${S.privSource}/dot_claude/.settings.managed.json`)) {
    err(`missing ${S.privSource}/dot_claude/.settings.managed.json`);
    throw new Exit(2);
  }
}

function runChecks(): number {
  checkSubmodule();
  const issues = [
    ["[1/5] chezmoi status (managed-file modifications)", checkStatus],
    ["[2/5] coverage (unmanaged files inside managed dirs)", checkCoverage],
    [`[3/5] shape (unmanaged top-level *.{${S.shapeExts}})`, checkShape],
    ["[4/5] mcp drift (settings.json vs ~/.claude.json user-level)", checkMcp],
    ["[5/5] lint (enabledPlugins/mcpServers shape, CC version, skill name, skill layers)", checkLint],
  ] as const;
  let total = 0;
  for (const [head, check] of issues) {
    log(head);
    total += check();
    log("");
  }
  log(`Total issues: ${total}`);
  const warns = [
    ["[warn 1/8] first-party plugin drift (installed sha vs claude-code-plugins origin/main)", checkPluginSrcDrift],
    ["[warn 2/8] cavemem health (hook, better-sqlite3, embedder, worker)", checkCavemem],
    ["[warn 3/8] safeguard toggle (switchModelsOnFlag=false in source + live settings.json)", checkSafeguard],
    ["[warn 4/8] user agents (cap of 4, 0-spawn-in-30d staleness via markers/subagent-spawns/)", checkUserAgents],
    ["[warn 5/8] rig version gate (validate, type check and tests after a Claude Code update)", checkRigGate],
    ["[warn 6/8] AI release stores (Codex daemon and Pi keep at most two releases)", checkAiReleases],
    ["[warn 7/8] dangling links (~/.bin and ~/.claude/skills)", checkLinks],
    ["[warn 8/8] agent additions (Claude, Pi and Codex items outside the source and docs/agent-additions.txt)", checkAdditions],
  ] as const;
  for (const [head, check] of warns) {
    log(head);
    check();
    log("");
  }
  return total === 0 ? 0 : 1;
}

function warnLines(report: string): string {
  return chomp(
    report
      .split("\n")
      .filter(line => new RegExp(`^${SPACE}*WARN: `).test(line))
      .map(line => line.replace(new RegExp(`^${SPACE}*WARN: `), ""))
      .join("\n"),
  );
}

function attempt(fn: () => unknown): boolean {
  try {
    fn();
    return true;
  } catch (error) {
    err((error as Error).message);
    return false;
  }
}

function remove(path: string): boolean {
  try {
    rmSync(path, { force: true });
    return true;
  } catch {
    return false;
  }
}

function writeWarnings(warnings: string): boolean {
  const file = `${S.claudeDir}/markers/doctor-warnings.txt`;
  if (!warnings) return remove(file);
  let tmp = "";
  try {
    mkdirSync(file.slice(0, file.lastIndexOf("/")), { recursive: true });
    tmp = `${file}.${Math.random().toString(36).slice(2, 8)}`;
    writeFileSync(tmp, `${warnings}\n`, { mode: 0o600, flag: "wx" });
    renameSync(tmp, file);
    return true;
  } catch {
    if (tmp) rmSync(tmp, { force: true });
    return false;
  }
}

function rewakeAdditions(): boolean {
  const file = `${S.claudeDir}/markers/doctor-warnings.txt`;
  const text = read(file);
  const kept = text === undefined ? "" : chomp(lines(text).filter(line => !line.startsWith("agent addition: ")).join("\n"));
  const added = warnLines(capture(checkAdditions));
  return writeWarnings(chomp(`${kept}\n${added}\n`.split("\n").filter(Boolean).join("\n")));
}

function rewakeFinish(rc: number, report: string): number {
  if (!writeWarnings(warnLines(report))) remove(`${S.claudeDir}/markers/doctor-warnings.txt`);
  if (rc === 0) return 0;
  err("chezmoi-claude-doctor: issues found. Run ~/.bin/chezmoi-claude-doctor for the full report.");
  err(report);
  return 2;
}

async function main(): Promise<number> {
  const arg = process.argv[2] ?? "";
  let mode: "run" | "rewake" = "run";
  if (arg === "--quiet") S.quiet = true;
  else if (arg === "--rewake") mode = "rewake";
  else if (arg === "--help" || arg === "-h") {
    writeSync(1, `${HELP}\n`);
    return 0;
  } else if (arg !== "") {
    err(`unknown arg: ${arg}`);
    return 2;
  }

  let outside = false;
  let failRc = 2;
  if (mode === "rewake") {
    if (env("CLAUDE_JOB_DIR")) return 0;
    if (!rewakeApplies(await sessionCwd())) {
      outside = true;
      failRc = 0;
      S.errTo = "drop";
    }
  }
  try {
    for (const tool of ["chezmoi", "sort"]) {
      if (!which(tool)) {
        err(`missing dependency: ${tool}`);
        return failRc;
      }
    }
    setManaged(buildManaged());
    loadIgnored();
    if (outside) {
      rewakeAdditions();
      return 0;
    }
    if (mode === "rewake") {
      const report: string[] = [];
      let rc: number;
      S.sink = report;
      S.errTo = "sink";
      try {
        rc = runChecks();
      } catch (error) {
        if (!(error instanceof Exit)) throw error;
        rc = error.code;
      } finally {
        S.sink = null;
        S.errTo = "stderr";
      }
      return rewakeFinish(rc, chomp(report.join("\n")));
    }
    return runChecks();
  } catch (error) {
    if (error instanceof Exit) return error.code;
    err(`chezmoi-claude-doctor: ${(error as Error).message ?? error}`);
    return failRc;
  }
}

process.exit(await main());
