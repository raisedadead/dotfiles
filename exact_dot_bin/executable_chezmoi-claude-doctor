}

function rigGateRun(out: string): boolean {
  let work: string;
  let fd: number;
  try {
    work = mkdtempSync(`${tmpdir()}/tmp.`);
  } catch {
    return false;
  }
  try {
    fd = openSync(out, "w");
  } catch {
    rmSync(work, { recursive: true, force: true });
    return false;
  }
  const step = (argv: string[], cwd?: string, input?: Uint8Array) => {
    try {
      const proc = Bun.spawnSync(argv, { cwd, env: process.env, stdin: input ?? "ignore", stdout: fd, stderr: fd });
      return proc.exitCode ?? 1;
    } catch (error) {
      writeSync(fd, `${(error as Error).message}\n`);
      return 127;
    }
  };
  try {
    const archive = Bun.spawnSync(["git", "-C", `${S.privSource}/dot_claude`, "archive", "HEAD", "mods/rig"], {
      env: process.env,
      stdin: "ignore",
      stdout: "pipe",
      stderr: fd,
    });
    const untar = step(["tar", "-x", "-C", work], undefined, archive.stdout);
    if (archive.exitCode !== 0 || untar !== 0) return false;
    const rig = `${work}/mods/rig`;
    if (!isDir(rig)) {
      writeSync(fd, `cd: ${rig}: No such file or directory\n`);
      return false;
    }
    return (
      step(["bun", "build.ts"], rig) === 0 &&
      step(["claude", "plugin", "validate", "dist"], rig) === 0 &&
      step(["claude", "plugin", "test", "dist"], rig) === 0
    );
  } catch {
    return false;
  } finally {
    closeSync(fd);
    rmSync(work, { recursive: true, force: true });
  }
}

function checkRigGate(): number {
  const types = `${S.claudeDir}/mods/rig/.claude-plugin/types/claude-code/index.d.ts`;
  const marker = `${S.claudeDir}/markers/rig-verified-version`;
  const out = `${S.claudeDir}/markers/rig-gate.log`;
  if (!isFile(types)) {
    log("  skip (no host types; Claude Code writes them when it loads the rig)");
    return 0;
  }
  const version = /^\/\/ Written by Claude Code ([^ ]+)\.$/.exec((read(types) ?? "").split("\n")[0])?.[1] ?? "";
  if (!version) {
    log(`  WARN: line 1 of ${tilde(types)} names no Claude Code version`);
    return 1;
  }
  const passed = chomp(read(marker) ?? "");
  if (version === passed) {
    log(`  clean (${version} verified)`);
    return 0;
  }
  for (const bin of ["claude", "bun", "bunx", "git"]) {
    if (!which(bin)) {
      log(`  skip (${bin} missing)`);
      return 0;
    }
  }
  if (!isDir(`${S.privSource}/dot_claude/mods/rig`)) {
    log(`  skip (${tilde(S.privSource)}/dot_claude/mods/rig missing)`);
    return 0;
  }
  attempt(() => mkdirSync(marker.slice(0, marker.lastIndexOf("/")), { recursive: true }));
  if (!rigGateRun(out)) {
    log(`  WARN: the committed rig fails build, validate or tests on Claude Code ${version}; read ${tilde(out)}`);
    return 1;
  }
  attempt(() => writeFileSync(marker, `${version}\n`));
  log(`  clean (${version} verified now)`);
  return 0;
}

