const TS = /^(\d\d\d\d)-(1[0-2]|0[1-9]|[1-9])-(3[01]|[12]\d|0[1-9]|[1-9]| [1-9])T(2[0-3]|[0-1]\d|\d):([0-5]\d|\d):(6[0-1]|[0-5]\d|\d)Z$/;

function utcSeconds(text: string): number | undefined {
  const match = TS.exec(text);
  if (!match) return undefined;
  const [year, month, day, hour, minute, second] = match.slice(1).map(Number);
  const date = new Date(Date.UTC(year, month - 1, day));
  if (date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return undefined;
  return Date.UTC(year, month - 1, day, hour, minute) / 1000 + second;
}

function userAgentIssues(agentsDir: string, logDir: string, cap: number): string[] {
  const agents = names(agentsDir)
    .filter(name => name.endsWith(".md"))
    .map(name => name.slice(0, -3))
    .sort();
  const window = 30 * 86400;
  const now = Date.now() / 1000;
  const issues: string[] = [];
  if (agents.length > cap) issues.push(`${agents.length} user agents exceed the cap of ${cap}`);
  const spawns = new Map<Json, number>();
  for (const file of names(logDir).filter(name => name.endsWith(".jsonl") && !name.startsWith("."))) {
    const text = read(`${logDir}/${file}`);
    if (text === undefined) continue;
    for (const line of text.split("\n")) {
      let entry: Json;
      try {
        entry = JSON.parse(line) as Json;
      } catch {
        continue;
      }
      if (!isObject(entry)) continue;
      const ts = Object.hasOwn(entry, "ts") ? entry.ts : "";
      const at = typeof ts === "string" ? utcSeconds(ts) : undefined;
      if (at === undefined) continue;
      if (now - at <= window) {
        const key = Object.hasOwn(entry, "agent_type") ? entry.agent_type : "";
        spawns.set(key, (spawns.get(key) ?? 0) + 1);
      }
    }
  }
  for (const name of agents) {
    const mtime = stat(`${agentsDir}/${name}.md`)?.mtimeMs;
    if (mtime !== undefined && now - mtime / 1000 < window) continue;
    if (!spawns.get(name)) issues.push(`agent '${name}' has 0 spawns in 30d - retire it or fix its trigger`);
  }
  return issues;
}

