function jqItems(file: string, fn: (root: Json, emit: (item: Json) => void) => void): string {
  if (!existsSync(file)) return "";
  let out = "";
  const emit = (item: Json) => {
    out += `${interp(item)}\n`;
  };
  try {
    for (const root of readJson(file)) fn(root, emit);
  } catch {
    out += `unreadable ${relHome(file)}\n`;
  }
  return out;
}

function slurp(path: string): Json {
  return readJson(path)[0] ?? null;
}

function manifestNames(path: string): Set<string> {
  const text = read(path);
  if (text === undefined) return new Set();
  return new Set(
    text
      .split("\n")
      .slice(0, text.endsWith("\n") ? -1 : undefined)
      .map(line => (line.includes("\t") ? line.split("\t")[1] : line)),
  );
}

function listUnmanagedChildren(kindName: string, dir: string, manifest = ""): string {
  if (!isDir(dir)) return "";
  let out = "";
  for (const path of children(dir)) {
    const name = path.slice(dir.length + 1);
    if (name.startsWith(".")) continue;
    if (isIgnored(path)) continue;
    if (isManaged(path)) {
      if (!kind(path)?.isDirectory()) continue;
      for (const { path: file } of walk(path)) {
        const type = kind(file);
        if (!type?.isFile() && !type?.isSymbolicLink()) continue;
        if (isManaged(file) || isIgnored(file)) continue;
        out += `${kindName} ${name}/${file.slice(path.length + 1)}\n`;
      }
      continue;
    }
    if (manifest && readable(manifest) && manifestNames(manifest).has(name)) continue;
    out += `${kindName} ${name}\n`;
  }
  return out;
}

type Item = { item: string; value?: Json };

function claudeItems(x: Json): Item[] {
  const items: Item[] = [];
  for (const [event, groups] of entries(alt(get(x, "hooks"), {}))) {
    for (const group of valuesTry(groups)) {
      const matcher = alt(get(group, "matcher"), "");
      for (const hook of valuesTry(get(group, "hooks"))) {
        const command = altLazy(
          () => get(hook, "command"),
          () => get(hook, "url"),
          () => get(hook, "prompt"),
          () => get(hook, "type"),
          () => "",
        );
        items.push({ item: `claude-hook ${interp(event)}[${interp(matcher)}]: ${interp(command)}` });
      }
    }
  }
  for (const [key, value] of entries(alt(get(x, "enabledPlugins"), {}))) items.push({ item: `claude-plugin ${interp(key)}`, value });
  for (const key of keys(alt(get(x, "extraKnownMarketplaces"), {}))) items.push({ item: `claude-marketplace ${interp(key)}` });
  for (const [key, value] of entries(alt(get(x, "mcpServers"), {}))) items.push({ item: `claude-mcp ${interp(key)}`, value });
  const command = (field: string) => {
    const holder = get(x, field);
    try {
      return get(holder, "command");
    } catch {
      return null;
    }
  };
  for (const [field, label] of [
    ["statusLine", "claude-statusline"],
    ["subagentStatusLine", "claude-statusline"],
    ["fileSuggestion", "claude-file-suggestion"],
  ]) {
    const value = command(field);
    if (value !== null && value !== false) items.push({ item: `${label} ${interp(value)}` });
  }
  const helper = get(x, "apiKeyHelper");
  if (helper !== null && helper !== false) items.push({ item: `claude-api-key-helper ${interp(helper)}` });
  for (const [key, value] of entries(alt(get(x, "env"), {}))) items.push({ item: `claude-env ${interp(key)}`, value });
  return items;
}

function itemsMinus(a: Item[], b: Item[]): Item[] {
  return a.filter(left => !b.some(right => equal(left as unknown as Json, right as unknown as Json)));
}

function listClaudeAdditions(): string {
  const source = `${S.privSource}/dot_claude/.settings.managed.json`;
  const installed = `${S.claudeDir}/plugins/installed_plugins.json`;
  let out = "";
  out += jqItems(`${S.claudeDir}/settings.json`, (root, emit) => {
    const base = slurp(source);
    for (const { item } of itemsMinus(claudeItems(root), claudeItems(base))) emit(item.replace(/[\n\r]/g, " "));
  });
  out += jqItems(`${S.claudeDir}/plugins/known_marketplaces.json`, (root, emit) => {
    const base = slurp(source);
    for (const key of minus(keys(root), keys(alt(get(base, "extraKnownMarketplaces"), {})))) emit(`claude-marketplace ${interp(key)}`);
  });
  out += jqItems(`${S.home}/.claude.json`, (root, emit) => {
    const base = slurp(source);
    const servers = (x: Json): Item[] => entries(alt(get(x, "mcpServers"), {})).map(([key, value]) => ({ item: `claude-mcp ${interp(key)}`, value }));
    for (const { item } of itemsMinus(servers(root), servers(base))) emit(item);
    for (const project of values(alt(get(root, "projects"), {}))) {
      for (const key of keys(alt(get(project, "mcpServers"), {}))) emit(`claude-project-mcp ${interp(key)}`);
    }
  });
  const pairs = jqItems(installed, (root, emit) => {
    for (const [plugin, installs] of entries(alt(get(root, "plugins"), {}))) {
      for (const install of values(installs)) emit(`${interp(plugin)}\t${interp(alt(get(install, "installPath"), ""))}`);
    }
  });
  for (const line of readLines(pairs)) {
    const trimmed = line.replace(/^\t+/, "");
    const tab = trimmed.indexOf("\t");
    const plugin = tab < 0 ? trimmed : trimmed.slice(0, tab);
    const dir = tab < 0 ? "" : trimmed.slice(tab).replace(/^\t+/, "").replace(/\t+$/, "");
    if (!dir) {
      out += `${plugin}\n`;
      continue;
    }
    out += jqItems(`${dir}/hooks/hooks.json`, (root, emit) => {
      for (const key of keys(alt(get(root, "hooks"), {}))) emit(`claude-plugin-hook ${plugin} ${interp(key)}`);
      for (const module of values(alt(get(root, "modules"), []))) emit(`claude-plugin-hook ${plugin} ${interp(module)}`);
    });
    out += jqItems(`${dir}/.claude-plugin/plugin.json`, (root, emit) => {
      const hooks = get(root, "hooks");
      if (hooks !== null && hooks !== false) emit(`claude-plugin-hook ${plugin} manifest`);
      const servers = get(root, "mcpServers");
      if (servers === null || servers === false) return;
      for (const name of isObject(servers) ? keys(servers) : [interp(servers)]) emit(`claude-plugin-mcp ${plugin} ${interp(name)}`);
    });
    out += jqItems(`${dir}/.mcp.json`, (root, emit) => {
      for (const key of keys(alt(get(root, "mcpServers"), root))) emit(`claude-plugin-mcp ${plugin} ${interp(key)}`);
    });
  }
  out += listUnmanagedChildren("claude-skills", `${S.claudeDir}/skills`, `${S.pubSource}/docs/skills.tsv`);
  for (const name of ["agents", "rules", "commands", "hooks", "output-styles", "workflows", "mods"]) {
    out += listUnmanagedChildren(`claude-${name}`, `${S.claudeDir}/${name}`);
  }
  for (const path of children(S.claudeDir)) {
    const type = kind(path);
    if (!type || (!type.isFile() && !type.isSymbolicLink())) continue;
    const name = path.slice(path.lastIndexOf("/") + 1);
    if (!(type.mode & 0o111) && !/\.(py|sh|js|mjs|ts)$/.test(name)) continue;
    if (isManaged(path) || isIgnored(path)) continue;
    out += `claude-script ${name}\n`;
  }
  return out;
}

function same(a: string, b: string): boolean {
  try {
    return readFileSync(a).equals(readFileSync(b));
  } catch {
    return false;
  }
}

function findFiles(dir: string, test: (path: string, depth: number) => boolean, max = Infinity): string[] {
  return walk(dir, max)
    .filter(({ path, depth }) => test(path, depth))
    .map(({ path }) => path);
}

