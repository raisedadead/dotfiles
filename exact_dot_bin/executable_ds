#!/bin/sh
root=${DS_PLUGIN_ROOT:-$(jq -r '.plugins["dossier@raisedadead-plugins"][0].installPath // empty' "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null)}
if [ -z "$root" ] || [ ! -f "$root/cli/ds" ]; then
	echo 'ds: the dossier plugin is not installed; run: claude plugin install dossier@raisedadead-plugins' >&2
	exit 69
fi
exec sh "$root/cli/ds" "$@"
