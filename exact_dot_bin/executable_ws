#!/usr/bin/env -S bun --no-env-file --config=/dev/null
import { appendFileSync, existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const IDLE_DAYS = 14;
const DAY = 86_400_000;
const LAYOUT = new Set(["START.md", "INDEX.md", "OPEN-WORK.md", "dossier", "handoff", "tmp", "research", "plans", "_archive"]);
const CLOSED = new Set(["done", "dropped", "moved"]);
const SHOWN = 3;
const STALE_LOCK_MS = 60_000;

type Workspace = { root: string; dir: string; note?: string };
type Row = { id: string; state: string; item: string; owner: string };
type Idle = { name: string; days: number };

function git(cwd: string, ...args: string[]): { code: number; out: string } {
  const proc = Bun.spawnSync(["git", ...args], { cwd, env: { ...process.env, GIT_OPTIONAL_LOCKS: "0" }, stdout: "pipe", stderr: "ignore" });
  return { code: proc.exitCode, out: proc.stdout.toString().trim() };
}

function home(): string {
  return process.env.HOME || homedir();
}

function mainCheckout(cwd: string, top: string): string {
  const [own, common] = git(cwd, "rev-parse", "--path-format=absolute", "--git-dir", "--git-common-dir").out.split("\n");
  if (!own || own === common) return top;
  const first = git(cwd, "worktree", "list", "--porcelain").out.split("\n")[0] ?? "";
  const main = first.startsWith("worktree ") ? first.slice("worktree ".length) : "";
  return main && !main.includes("/.git/") && existsSync(main) ? main : top;
}

function locate(cwd: string): Workspace {
  const top = git(cwd, "rev-parse", "--show-toplevel");
  const fallback = (note: string): Workspace => ({ root: home(), dir: join(home(), ".scratchpad"), note });
  if (top.code !== 0 || !top.out) return fallback("not in a git repo, so this uses ~/.scratchpad");
  const root = mainCheckout(cwd, top.out);
  if (git(root, "check-ignore", "-q", ".scratchpad/").code !== 0) {
    return fallback(".scratchpad is not git-ignored in this repo, so this uses ~/.scratchpad");
  }
  return { root, dir: join(root, ".scratchpad") };
}

function entries(dir: string): string[] {
  try {
    return readdirSync(dir).sort();
  } catch {
    return [];
  }
}

function cells(line: string, width = 0): string[] {
  const aware = split(line, true);
  return width && aware.length !== width ? split(line, false) : aware;
}

function split(line: string, backticks: boolean): string[] {
  const out: string[] = [];
  let cell = "";
  let code = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (ch === "\\" && line[i + 1] === "|") {
      cell += "|";
      i++;
    } else if (ch === "`" && backticks) {
      code = !code;
      cell += ch;
    } else if (ch === "|" && !code) {
      out.push(cell.trim());
      cell = "";
    } else {
      cell += ch;
    }
  }
  out.push(cell.trim());
  return out.slice(1, -1);
}

function openTableRows(text: string): Record<string, string>[] {
  const rows: Record<string, string>[] = [];
  let columns: string[] | undefined;
  for (const line of text.split("\n")) {
    if (!line.startsWith("|")) {
      columns = undefined;
      continue;
    }
    const row = cells(line, columns?.length);
    if (!columns) {
      columns = row.map(c => c.toLowerCase());
      continue;
    }
    if (row.every(c => /^:?-+:?$/.test(c))) continue;
    const named = Object.fromEntries(columns.map((name, i) => [name, row[i] ?? ""]));
    if (!columns.includes("state") || CLOSED.has(named.state.toLowerCase())) continue;
    rows.push(named);
  }
  return rows;
}

function openRows(text: string): Row[] {
  return openTableRows(text).map(row => ({ id: row.id ?? "", state: row.state.toLowerCase(), item: row.item ?? "", owner: row.owner ?? "" }));
}

function newestFile(path: string): number {
  const stat = lstatSync(path);
  if (!stat.isDirectory()) return stat.mtimeMs;
  return Math.max(-Infinity, ...entries(path).map(name => newestFile(join(path, name))));
}

function age(folder: string, now: number): number {
  const at = newestFile(folder);
  return Math.floor((now - (at === -Infinity ? lstatSync(folder).mtimeMs : at)) / DAY);
}

function idle(dir: string, now = Date.now()): Idle[] {
  const tmp = join(dir, "tmp");
  return entries(tmp)
    .filter(name => lstatSync(join(tmp, name)).isDirectory())
    .map(name => ({ name, days: age(join(tmp, name), now) }))
    .filter(folder => folder.days >= IDLE_DAYS);
}

function loose(dir: string): string[] {
  return entries(dir).filter(name => !name.startsWith(".") && !LAYOUT.has(name));
}

function handoffs(dir: string): string[] {
  return entries(join(dir, "handoff")).filter(name => name.endsWith(".md"));
}

function clip(text: string, max = 160): string {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

function names(list: string[]): string {
  const more = list.length > SHOWN ? ` (+${list.length - SHOWN} more)` : "";
  return list.slice(0, SHOWN).join(", ") + more;
}

function render(ws: Workspace, found: { handoffs: string[]; rows: Row[]; idle: Idle[]; loose: string[] }): string {
  const link = (path: string, what: string) => (existsSync(join(ws.dir, path)) ? [`- [${path}](${path}): ${what}`] : []);
  const list = (items: string[], empty: string) => (items.length ? items : [empty]);
  const lines = [
    "# Workspace start",
    "",
    `Rebuilt by \`ws\` at ${new Date().toISOString().slice(0, 16)}Z. Do not edit this file; run \`ws\` to rebuild it.`,
    "",
    `Project: \`${ws.root}\``,
    ...(ws.note ? ["", `Note: ${ws.note}.`] : []),
    "",
    "## Read next",
    "",
    ...list([...link("INDEX.md", "live dossiers"), ...link("dossier/LATER.md", "carried work"), ...link("OPEN-WORK.md", "open work register")], "- Nothing yet."),
    "",
    "## Handoffs",
    "",
    "Pick one up, then move it to `_archive/handoff/`.",
    "",
    ...list(found.handoffs.map(name => `- [handoff/${name}](handoff/${name})`), "- None."),
    "",
    "## Open work",
    "",
    ...list(found.rows.map(row => `- ${row.id} (${row.state}): ${clip(row.item)}`), "- None."),
    "",
    "## Idle tmp folders",
    "",
    `Newest file ${IDLE_DAYS} or more days old. \`ws tidy\` moves them to \`_archive/tmp/\`.`,
    "",
    ...list(found.idle.map(folder => `- \`tmp/${folder.name}\` (${folder.days} days)`), "- None."),
    "",
    "## Loose names",
    "",
    "Names outside the layout. Move each one into the folder that fits it.",
    "",
    ...list(found.loose.map(name => `- \`${name}\``), "- None."),
    "",
  ];
  return lines.join("\n");
}

function summary(ws: Workspace, found: { handoffs: string[]; rows: Row[]; idle: Idle[]; loose: string[] }): string[] {
  return [
    `ws: ${join(ws.dir, "START.md")}`,
    ...(ws.note ? [`ws: ${ws.note}`] : []),
    ...(found.handoffs.length ? [`handoffs: ${found.handoffs.length} — ${names(found.handoffs.map(name => `handoff/${name}`))}`] : []),
    ...(found.rows.length ? [`open work rows: ${found.rows.length} (OPEN-WORK.md)`] : []),
    ...(found.idle.length ? [`idle tmp folders: ${found.idle.length} — run \`ws tidy\` to archive them`] : []),
    ...(found.loose.length ? [`names outside the layout: ${found.loose.length} — ${names(found.loose)}`] : []),
  ];
}

function build(cwd: string): string[] {
  const ws = locate(cwd);
  mkdirSync(ws.dir, { recursive: true });
  const work = join(ws.dir, "OPEN-WORK.md");
  const found = {
    handoffs: handoffs(ws.dir),
    rows: existsSync(work) ? openRows(readFileSync(work, "utf8")) : [],
    idle: idle(ws.dir),
    loose: loose(ws.dir),
  };
  const fresh = join(ws.dir, `.START.md.${process.pid}`);
  writeFileSync(fresh, render(ws, found));
  renameSync(fresh, join(ws.dir, "START.md"));
  return summary(ws, found);
}

const DATED = /\b(?:due|until) (\d{4}-\d{2}-\d{2})\b/;

function read(path: string): string {
  return existsSync(path) ? readFileSync(path, "utf8") : "";
}

function isDue(text: string, today: string): boolean {
  const date = DATED.exec(text)?.[1];
  return date !== undefined && date <= today;
}

function due(dir: string, today: string): string[] {
  const later = read(join(dir, "dossier", "LATER.md"))
    .split("\n")
    .filter(line => isDue(line, today))
    .map(line => `- \`dossier/LATER.md\`: ${line.replace(/^-\s*/, "")}`);
  const rows = openTableRows(read(join(dir, "OPEN-WORK.md")))
    .filter(row => isDue(Object.values(row).join(" "), today))
    .map(row => `- \`OPEN-WORK.md\`: ${row.id} (${row.owner || "agent"}, ${row.state}): ${row.item}`);
  return [...later, ...rows];
}

function liveDossiers(dir: string): string[] {
  return openTableRows(read(join(dir, "INDEX.md")))
    .filter(row => row.state.toLowerCase() === "live")
    .map(row => `- \`${join(dir, "dossier", `${row.date}-${row.slug}`, "DOSSIER.md")}\` (${row.t ?? "?"})`);
}

function gitState(cwd: string): string[] {
  const top = git(cwd, "rev-parse", "--show-toplevel");
  if (top.code !== 0 || !top.out) return [];
  const root = top.out;
  const subs = git(root, "submodule", "foreach", "--quiet", "--recursive", 'echo "$displaypath"').out.split("\n").filter(Boolean);
  return [".", ...subs].map(path => {
    const lines = git(join(root, path), "status", "--porcelain=v2", "--branch").out.split("\n").filter(Boolean);
    const head = lines.find(line => line.startsWith("# branch.head "))?.slice("# branch.head ".length) ?? "?";
    const ahead = lines.find(line => line.startsWith("# branch.ab "))?.match(/\+(\d+)/)?.[1];
    const dirty = lines.filter(line => !line.startsWith("#")).length;
    return `- \`${path}\` ${head}: ${dirty} uncommitted, ${ahead === undefined ? "no upstream" : `${ahead} unpushed`}`;
  });
}

function brief(cwd: string, today = new Date().toLocaleDateString("en-CA")): string {
  const ws = locate(cwd);
  const rows = openRows(read(join(ws.dir, "OPEN-WORK.md")));
  const line = (row: Row) => `- ${row.id} (${row.state}): ${row.item}`;
  const block = (name: string, items: string[]) => [`## ${name}`, "", ...(items.length ? items : ["- None."]), ""];
  return [
    "# Workspace brief",
    "",
    `Project: \`${ws.root}\``,
    ...(ws.note ? [`Note: ${ws.note}.`] : []),
    "",
    ...block("Handoffs", handoffs(ws.dir).map(name => `- \`${join(ws.dir, "handoff", name)}\``)),
    ...block("Due", due(ws.dir, today)),
    ...block("Agent work", rows.filter(row => !row.owner || row.owner === "agent").map(line)),
    ...block("Operator work", rows.filter(row => row.owner && row.owner !== "agent").map(line)),
    ...block("Live dossiers", liveDossiers(ws.dir)),
    ...block("Git", gitState(cwd)),
  ].join("\n");
}

function alive(pid: number): boolean {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return (error as NodeJS.ErrnoException).code === "EPERM";
  }
}

function staleOwner(path: string): string | undefined {
  try {
    const owner = readFileSync(path, "utf8");
    const pid = Number.parseInt(owner, 10);
    if (pid > 0) return alive(pid) ? undefined : owner;
    return Date.now() - lstatSync(path).mtimeMs > STALE_LOCK_MS ? owner : undefined;
  } catch {
    return "";
  }
}

function lock(dir: string): string | undefined {
  const path = join(dir, ".ws-tidy.lock");
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      writeFileSync(path, String(process.pid), { flag: "wx" });
      return path;
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
    }
    const owner = staleOwner(path);
    if (owner === undefined) return undefined;
    const aside = `${path}.${process.pid}`;
    try {
      renameSync(path, aside);
    } catch {
      continue;
    }
    if (readFileSync(aside, "utf8") !== owner) {
      renameSync(aside, path);
      return undefined;
    }
    rmSync(aside, { force: true });
  }
  return undefined;
}

function tidy(cwd: string): number {
  const ws = locate(cwd);
  mkdirSync(ws.dir, { recursive: true });
  const held = lock(ws.dir);
  if (!held) {
    console.error(`ws tidy: another ws tidy holds the lock ${join(ws.dir, ".ws-tidy.lock")}`);
    return 1;
  }
  let code = 0;
  try {
    const archive = join(ws.dir, "_archive", "tmp");
    const log = join(ws.dir, "_archive", `MOVED-${new Date().toISOString().slice(0, 10)}.txt`);
    for (const folder of idle(ws.dir)) {
      const target = join(archive, folder.name);
      mkdirSync(archive, { recursive: true });
      try {
        mkdirSync(target);
      } catch {
        console.error(`ws tidy: tmp/${folder.name} stays; _archive/tmp/${folder.name} already exists`);
        code = 1;
        continue;
      }
      renameSync(join(ws.dir, "tmp", folder.name), target);
      appendFileSync(log, `${new Date().toISOString()} ws tidy: tmp/${folder.name} -> _archive/tmp/${folder.name}\n`);
      console.log(`moved tmp/${folder.name} -> _archive/tmp/${folder.name}`);
    }
  } finally {
    rmSync(held, { force: true });
  }
  console.log(build(cwd).join("\n"));
  return code;
}

if (import.meta.main) {
  const [verb] = process.argv.slice(2);
  if (verb === undefined) {
    console.log(build(process.cwd()).join("\n"));
  } else if (verb === "tidy") {
    process.exit(tidy(process.cwd()));
  } else if (verb === "brief") {
    console.log(brief(process.cwd()));
  } else {
    console.error("Usage: ws [tidy|brief]");
    process.exit(64);
  }
}
