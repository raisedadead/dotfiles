#!/usr/bin/env -S bun --no-env-file --config=/dev/null
import { existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const IDLE_DAYS = 14;
const DAY = 86_400_000;
const LAYOUT = new Set(["START.md", "INDEX.md", "OPEN-WORK.md", "dossier", "handoff", "tmp", "research", "plans", "_archive"]);
const CLOSED = new Set(["done", "dropped", "moved"]);
const SHOWN = 3;

type Workspace = { root: string; dir: string; note?: string };
type Row = { id: string; state: string; item: string };
type Idle = { name: string; days: number };

function git(cwd: string, ...args: string[]): { code: number; out: string } {
  const proc = Bun.spawnSync(["git", ...args], { cwd, stdout: "pipe", stderr: "ignore" });
  return { code: proc.exitCode, out: proc.stdout.toString().trim() };
}

function home(): string {
  return process.env.HOME || homedir();
}

function locate(cwd: string): Workspace {
  const top = git(cwd, "rev-parse", "--show-toplevel");
  const fallback = (note: string): Workspace => ({ root: home(), dir: join(home(), ".scratchpad"), note });
  if (top.code !== 0 || !top.out) return fallback("not in a git repo, so this uses ~/.scratchpad");
  if (git(top.out, "check-ignore", "-q", ".scratchpad/START.md").code !== 0) {
    return fallback(".scratchpad is not git-ignored in this repo, so this uses ~/.scratchpad");
  }
  return { root: top.out, dir: join(top.out, ".scratchpad") };
}

function entries(dir: string): string[] {
  try {
    return readdirSync(dir).sort();
  } catch {
    return [];
  }
}

function cells(line: string): string[] {
  const out: string[] = [];
  let cell = "";
  let code = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (ch === "\\" && line[i + 1] === "|") {
      cell += "|";
      i++;
    } else if (ch === "`") {
      code = !code;
      cell += ch;
    } else if (ch === "|" && !code) {
      out.push(cell.trim());
      cell = "";
    } else {
      cell += ch;
    }
  }
  out.push(cell.trim());
  return out.slice(1, -1);
}

function openRows(text: string): Row[] {
  const rows: Row[] = [];
  let columns: string[] | undefined;
  for (const line of text.split("\n")) {
    if (!line.startsWith("|")) {
      columns = undefined;
      continue;
    }
    const row = cells(line);
    if (!columns) {
      columns = row.map(c => c.toLowerCase());
      continue;
    }
    if (row.every(c => /^:?-+:?$/.test(c))) continue;
    const at = (name: string) => row[columns!.indexOf(name)] ?? "";
    const state = at("state").toLowerCase();
    if (!columns.includes("state") || CLOSED.has(state)) continue;
    rows.push({ id: at("id"), state, item: at("item") });
  }
  return rows;
}

function newest(path: string): number {
  const stat = lstatSync(path);
  if (!stat.isDirectory()) return stat.mtimeMs;
  const times = entries(path).map(name => newest(join(path, name)));
  return times.length ? Math.max(...times) : stat.mtimeMs;
}

function idle(dir: string, now = Date.now()): Idle[] {
  const tmp = join(dir, "tmp");
  return entries(tmp)
    .filter(name => lstatSync(join(tmp, name)).isDirectory())
    .map(name => ({ name, days: Math.floor((now - newest(join(tmp, name))) / DAY) }))
    .filter(folder => folder.days >= IDLE_DAYS);
}

function loose(dir: string): string[] {
  return entries(dir).filter(name => !name.startsWith(".") && !LAYOUT.has(name));
}

function handoffs(dir: string): string[] {
  return entries(join(dir, "handoff")).filter(name => name.endsWith(".md"));
}

function clip(text: string, max = 160): string {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

function names(list: string[]): string {
  const more = list.length > SHOWN ? ` (+${list.length - SHOWN} more)` : "";
  return list.slice(0, SHOWN).join(", ") + more;
}

function render(ws: Workspace, found: { handoffs: string[]; rows: Row[]; idle: Idle[]; loose: string[] }): string {
  const link = (path: string, what: string) => (existsSync(join(ws.dir, path)) ? [`- [${path}](${path}): ${what}`] : []);
  const list = (items: string[], empty: string) => (items.length ? items : [empty]);
  const lines = [
    "# Workspace start",
    "",
    `Rebuilt by \`ws\` at ${new Date().toISOString().slice(0, 16)}Z. Do not edit this file; run \`ws\` to rebuild it.`,
    "",
    `Project: \`${ws.root}\``,
    ...(ws.note ? ["", `Note: ${ws.note}.`] : []),
    "",
    "## Read next",
    "",
    ...list([...link("INDEX.md", "live dossiers"), ...link("dossier/LATER.md", "carried work"), ...link("OPEN-WORK.md", "open work register")], "- Nothing yet."),
    "",
    "## Handoffs",
    "",
    "Pick one up, then move it to `_archive/handoff/`.",
    "",
    ...list(found.handoffs.map(name => `- [handoff/${name}](handoff/${name})`), "- None."),
    "",
    "## Open work",
    "",
    ...list(found.rows.map(row => `- ${row.id} (${row.state}): ${clip(row.item)}`), "- None."),
    "",
    "## Idle tmp folders",
    "",
    `Newest file ${IDLE_DAYS} or more days old. \`ws tidy\` moves them to \`_archive/tmp/\`.`,
    "",
    ...list(found.idle.map(folder => `- \`tmp/${folder.name}\` (${folder.days} days)`), "- None."),
    "",
    "## Loose names",
    "",
    "Names outside the layout. Move each one into the folder that fits it.",
    "",
    ...list(found.loose.map(name => `- \`${name}\``), "- None."),
    "",
  ];
  return lines.join("\n");
}

function summary(ws: Workspace, found: { handoffs: string[]; rows: Row[]; idle: Idle[]; loose: string[] }): string[] {
  return [
    `ws: ${join(ws.dir, "START.md")}`,
    ...(ws.note ? [`ws: ${ws.note}`] : []),
    ...(found.handoffs.length ? [`handoffs: ${found.handoffs.length} — ${names(found.handoffs.map(name => `handoff/${name}`))}`] : []),
    ...(found.rows.length ? [`open work rows: ${found.rows.length} (OPEN-WORK.md)`] : []),
    ...(found.idle.length ? [`idle tmp folders: ${found.idle.length} — run \`ws tidy\` to archive them`] : []),
    ...(found.loose.length ? [`names outside the layout: ${found.loose.length} — ${names(found.loose)}`] : []),
  ];
}

function build(cwd: string): string[] {
  const ws = locate(cwd);
  mkdirSync(ws.dir, { recursive: true });
  const work = join(ws.dir, "OPEN-WORK.md");
  const found = {
    handoffs: handoffs(ws.dir),
    rows: existsSync(work) ? openRows(readFileSync(work, "utf8")) : [],
    idle: idle(ws.dir),
    loose: loose(ws.dir),
  };
  const fresh = join(ws.dir, `.START.md.${process.pid}`);
  writeFileSync(fresh, render(ws, found));
  renameSync(fresh, join(ws.dir, "START.md"));
  return summary(ws, found);
}

if (import.meta.main) {
  const [verb] = process.argv.slice(2);
  if (verb === undefined) {
    console.log(build(process.cwd()).join("\n"));
  } else {
    console.error("Usage: ws");
    process.exit(64);
  }
}
