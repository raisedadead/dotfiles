#!/usr/bin/env -S bun --no-env-file --config=/dev/null
import { readdirSync, readFileSync, statSync } from "node:fs";
import { join } from "node:path";

const DAY = 86_400_000;
const HOME = process.env.HOME ?? "";
const PROJECTS = join(HOME, ".claude/projects");
const SHORT = 260;
const RESULT_CHARS = 500;

const NOT_OPERATOR = ["<bash-", "<local-command", "<task-notification", "<command-", "<system-reminder", "This session is being continued", "Stop hook feedback", "A session-scoped Stop hook", "[Request interrupted", "Caveat:"];
const CORRECTION = /^\W*(?:no\b|nope\b|wrong\b|stop\b|wait\b|hold on\b|actually\b|why (?:did|do|are|would|have) you\b|why the\b|you did ?n[o']t\b|you didn't\b|you keep\b|you are veering\b|do not\b|don't\b|i do ?n[o']t\b|i don't\b|i said\b|i told you\b|i asked\b|that(?:'s| is) not\b|not what i\b|undo\b|incorrect\b)/i;
const PROBE = /(?:^|[/-])(?:private[/-])?tmp(?:[/-]|$)|rigfx|probe/i;
const HARNESS = ["String to replace not found", "File has been modified", "No changes to make", "Error: No such tool", "File does not exist", "File content", "Found ", "Cancelled", "InputValidationError", "Sibling tool call errored", "Error: File"];
const RIG = ["This session is isolated", "This agent is isolated", "This Bash command contains", "This command requires approval", "The user doesn't want", "A variable in this command", "PreToolUse:", "TaskCreated hook", "Permission to use", "PermissionDenied"];
const ERROR_TAG = "<tool_use_error>";

type Row = Record<string, any>;
type Week = { week: string; operatorMessages: number; corrections: number; toolResults: number; refusals: number };

const dayOf = (at: number): string => new Date(at).toISOString().slice(0, 10);
const rate = (part: number, whole: number): number => (whole ? Math.round((part / whole) * 1000) / 10 : 0);

function isoWeek(at: number): string {
  const date = new Date(at);
  const day = date.getUTCDay() || 7;
  date.setUTCDate(date.getUTCDate() + 4 - day);
  const first = Date.UTC(date.getUTCFullYear(), 0, 1);
  return `${date.getUTCFullYear()}-W${String(Math.ceil(((date.getTime() - first) / DAY + 1) / 7)).padStart(2, "0")}`;
}

function textOf(content: unknown): string {
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return "";
  return content
    .map(block => (block?.type === "text" ? String(block.text ?? "") : block?.type === "tool_result" ? textOf(block.content) : null))
    .filter(text => text !== null)
    .join("\n");
}

// A rig refusal is a failed tool result that a hook, a guard or the permission layer wrote; the harness's own errors do not count.
function isRefusal(text: string): boolean {
  const body = text.startsWith(ERROR_TAG) ? text.slice(ERROR_TAG.length) : text;
  if (HARNESS.some(start => body.startsWith(start))) return false;
  return text.startsWith(ERROR_TAG) || RIG.some(start => text.startsWith(start)) || text.slice(0, 60).includes("hook feedback");
}

function isOperator(row: Row): boolean {
  if (row.isSidechain || row.isMeta) return false;
  const origin = row.origin && typeof row.origin === "object" ? row.origin.kind : row.origin;
  return origin === "human" || (origin == null && row.turnOrigin === "human" && row.promptSource == null);
}

const isCorrection = (text: string): boolean => text.length < SHORT && CORRECTION.test(text);

function jsonlFiles(dir: string, since: number, found: string[] = []): string[] {
  let names: string[];
  try {
    names = readdirSync(dir);
  } catch {
    return found;
  }
  for (const name of names) {
    const path = join(dir, name);
    let stat;
    try {
      stat = statSync(path);
    } catch {
      continue;
    }
    if (stat.isDirectory()) jsonlFiles(path, since, found);
    else if (name.endsWith(".jsonl") && stat.mtimeMs >= since) found.push(path);
  }
  return found;
}

function count(since: number, until: number): Week[] {
  const weeks = new Map<string, Week>();
  const weekOf = (at: number): Week => {
    const week = isoWeek(at);
    if (!weeks.has(week)) weeks.set(week, { week, operatorMessages: 0, corrections: 0, toolResults: 0, refusals: 0 });
    return weeks.get(week)!;
  };
  for (const path of jsonlFiles(PROJECTS, since)) {
    const side = path.includes("/subagents/");
    const probe = PROBE.test(path.slice(PROJECTS.length + 1).split("/")[0] ?? "");
    let text: string;
    try {
      text = readFileSync(path, "utf8");
    } catch {
      continue;
    }
    for (let from = 0; from < text.length; ) {
      const end = text.indexOf("\n", from);
      const line = text.slice(from, end < 0 ? text.length : end);
      from = end < 0 ? text.length : end + 1;
      if (!line.includes('"type":"user"')) continue;
      let row: Row;
      try {
        row = JSON.parse(line);
      } catch {
        continue;
      }
      const at = Date.parse(row.timestamp ?? "");
      if (row.type !== "user" || !(at >= since && at < until)) continue;
      const content = row.message?.content;
      const results = Array.isArray(content) ? content.filter(block => block?.type === "tool_result") : [];
      const week = weekOf(at);
      for (const result of results) {
        week.toolResults += 1;
        if (result.is_error && isRefusal(textOf(result.content).slice(0, RESULT_CHARS))) week.refusals += 1;
      }
      if (results.length || side || probe || PROBE.test(String(row.cwd ?? "")) || !isOperator(row)) continue;
      const said = textOf(content).trim();
      if (!said || NOT_OPERATOR.some(start => said.startsWith(start))) continue;
      week.operatorMessages += 1;
      if (isCorrection(said)) week.corrections += 1;
    }
  }
  return [...weeks.values()].sort((a, b) => a.week.localeCompare(b.week));
}

function report(days: number, until: number) {
  const since = until - days * DAY;
  const weeks = count(since, until);
  const sum = (key: keyof Omit<Week, "week">): number => weeks.reduce((n, week) => n + week[key], 0);
  const shown = (week: Omit<Week, "week"> & { week?: string }) => ({
    ...week,
    correctionsPer100: rate(week.corrections, week.operatorMessages),
    refusalsPer100: rate(week.refusals, week.toolResults),
  });
  return {
    window: { since: dayOf(since), until: dayOf(until - DAY), days },
    weeks: weeks.map(shown),
    total: shown({ operatorMessages: sum("operatorMessages"), corrections: sum("corrections"), toolResults: sum("toolResults"), refusals: sum("refusals") }),
  };
}

function parse(argv: string[]): { until: number; days: number } {
  const args = [...argv];
  let until = Date.parse(`${dayOf(Date.now())}T00:00:00Z`) + DAY;
  const rest: string[] = [];
  while (args.length) {
    const arg = args.shift() ?? "";
    if (arg === "--until") {
      const value = args.shift() ?? "";
      if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) throw new Error(`--until needs YYYY-MM-DD, got "${value}"`);
      until = Date.parse(`${value}T00:00:00Z`) + DAY;
    } else rest.push(arg);
  }
  const days = Number(rest[0] ?? 30);
  if (rest.length > 1 || !Number.isInteger(days) || days < 1) throw new Error(`days must be one whole number, got "${rest.join(" ")}"`);
  return { until, days };
}

function main(): number {
  let options: ReturnType<typeof parse>;
  try {
    options = parse(process.argv.slice(2));
  } catch (error) {
    console.error(`rig-metrics: ${(error as Error).message}\nusage: rig-metrics [--until YYYY-MM-DD] [days]`);
    return 64;
  }
  console.log(JSON.stringify(report(options.days, options.until), null, 2));
  return 0;
}

process.exit(main());
