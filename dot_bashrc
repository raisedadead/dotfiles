#-----------------------------------------------------------
# Minimal on purpose. zsh is the shell. This file only makes a bash
# process that something else spawns behave correctly.

# Non-interactive bailout
[[ $- != *i* ]] && return

export LC_CTYPE=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="nvim"

# --- PATH ---
# The fnm default-alias dir must stay ABOVE Homebrew, or bash resolves
# Homebrew's node. path.zsh carries the same prepend; keep the two in sync.
export HOMEBREW_PREFIX="/opt/homebrew"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
[[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/fnm/aliases/default/bin" ]] && export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/fnm/aliases/default/bin:$PATH"
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.bin" ]] && export PATH="$HOME/.bin:$PATH"
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
[[ -d "$PNPM_HOME/bin" ]] && export PATH="$PNPM_HOME/bin:$PATH"
