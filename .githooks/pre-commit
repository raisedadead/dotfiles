#!/bin/bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
	printf '\e[0;31mdotfiles ·\e[0m gitleaks not found — refusing to commit\n' >&2
	printf '  this repository is public; the secret scan is not optional\n' >&2
	printf '  brew install gitleaks\n' >&2
	exit 1
fi

if [ -f .gitmodules ]; then
	dirty=$(git submodule foreach --quiet 'git status --porcelain | grep -q . && printf "%s\n" "$sm_path"; true')
	if [ -n "$dirty" ]; then
		printf '\e[0;31mdotfiles ·\e[0m submodule has uncommitted changes: %s\n' "$dirty" >&2
		printf '  commit inside the submodule first, then commit the gitlink here\n' >&2
		exit 1
	fi
fi

report=$(gitleaks git --staged --redact --no-banner 2>&1) && exit 0

printf '\e[0;31mdotfiles ·\e[0m gitleaks found a secret in the staged changes\n' >&2
printf '%s\n' "$report" >&2
printf '\e[0;90mdotfiles ·\e[0m values are redacted above; unstage the file or encrypt it\n' >&2
exit 1
