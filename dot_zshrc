# Performance profiling (set ZPROF=true to enable)
[[ "$ZPROF" = true ]] && zmodload zsh/zprof

#-----------------------------------------------------------
# Core Settings
#-----------------------------------------------------------
umask 022
limit coredumpsize 0

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=999999999
SAVEHIST=$HISTSIZE
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY

# Options
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt CDABLE_VARS
setopt INTERACTIVECOMMENTS
stty -ixon -ixoff 2>/dev/null

# Helpers
can_haz() { whence -p "$1" >/dev/null 2>&1 }
timezsh() { for i in {1..10}; do time zsh -i -c exit; done }

# Tmux exit code indicator (must be first precmd to capture $? before OMP)
_tmux_exit_code() { [[ -n "$TMUX" ]] && tmux set-option -qw @last_exit_code $?; }
precmd_functions=(_tmux_exit_code $precmd_functions)

# Keybindings
bindkey -e  # Emacs mode
bindkey '^z' vi-cmd-mode
bindkey -M vicmd '^z' vi-add-next

function zle-keymap-select {
  if [[ "$KEYMAP" == "vicmd" ]]; then
    export POSH_VI_MODE="cmd"
  else
    unset POSH_VI_MODE
  fi
  # Re-generate OMP prompt (reads updated POSH_VI_MODE), then redisplay
  if (( $+functions[_omp_get_prompt] )); then
    eval "$(_omp_get_prompt primary --eval)"
  fi
  zle .reset-prompt
}
zle -N zle-keymap-select
bindkey '^[a' backward-word         # Alt+a: beginning of word
bindkey '^[A' beginning-of-line     # Alt+Shift+a: beginning of line
bindkey '^[e' emacs-forward-word    # Alt+e: end of word
bindkey '^[E' end-of-line           # Alt+Shift+e: end of line
bindkey '^[[1;3C' forward-word      # Alt+Right: forward word
bindkey '^[[1;3D' backward-word     # Alt+Left: backward word
bindkey '^[[1;4C' end-of-line       # Alt+Shift+Right: end of line
bindkey '^[[1;4D' beginning-of-line # Alt+Shift+Left: beginning of line

# Prompt (oh-my-posh)
can_haz oh-my-posh && eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/config.toml)"

#-----------------------------------------------------------
# Plugins
#-----------------------------------------------------------
ZPLUGDIR="$HOME/.local/share/zsh/plugins"
ZPLUGS=(
  zsh-users/zsh-completions
  wbingli/zsh-claudecode-completion
  Aloxaf/fzf-tab
  zdharma-continuum/fast-syntax-highlighting
  zsh-users/zsh-autosuggestions
  raisedadead/zsh-smartinput
  g-plane/pnpm-shell-completion
  raisedadead/zsh-touchplus
  sobolevn/wakatime-zsh-plugin
)
local _repo
for _repo in $ZPLUGS; do
  [[ -d "$ZPLUGDIR/${_repo:t}" ]] || git clone --depth=1 "https://github.com/$_repo" "$ZPLUGDIR/${_repo:t}"
done
# pnpm-shell-completion ships a helper binary; zplug.zsh fetches the prebuilt release
[[ -x "$ZPLUGDIR/pnpm-shell-completion/pnpm-shell-completion" ]] || (cd "$ZPLUGDIR/pnpm-shell-completion" && ./zplug.zsh) >/dev/null 2>&1

zsh-plugin-update() {
  local d
  for d in "$ZPLUGDIR"/*(/); do git -C "$d" pull --ff-only; done
  (cd "$ZPLUGDIR/pnpm-shell-completion" && ./zplug.zsh)
}

# FZF
source ~/.fzf.zsh
source ~/.fzf.zshrc

#-----------------------------------------------------------
# Completions
#-----------------------------------------------------------
fpath+=("$ZPLUGDIR/zsh-completions/src" "$ZPLUGDIR/zsh-claudecode-completion")
[[ -n "$HOMEBREW_PREFIX" ]] && fpath+=("$HOMEBREW_PREFIX/share/zsh/site-functions")
[[ -d ~/.zfunc ]] && fpath=("$HOME/.zfunc" $fpath)

autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit -d ~/.zcompdump
else
  compinit -C -d ~/.zcompdump
fi

# Regenerate static completions in ~/.zfunc after upgrading these tools
update-completions() {
  mkdir -p ~/.zfunc
  can_haz gh && gh completion -s zsh > ~/.zfunc/_gh
  can_haz op && op completion zsh > ~/.zfunc/_op
  can_haz bd && bd completion zsh > ~/.zfunc/_bd
  can_haz wrangler && wrangler complete zsh | sed -n '/^#compdef/,$p' > ~/.zfunc/_wrangler  # strip pre-#compdef banner (wrangler 4.94+ leaks skills-install nag to stdout)
  rm -f ~/.zcompdump && autoload -Uz compinit && compinit -d ~/.zcompdump
}

# fzf-tab must load after compinit, before widget-wrapping plugins
source "$ZPLUGDIR/fzf-tab/fzf-tab.plugin.zsh"
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' fzf-flags --height=~60%

source "$ZPLUGDIR/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
source "$ZPLUGDIR/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"
source "$ZPLUGDIR/zsh-smartinput/smartinput.plugin.zsh"
source "$ZPLUGDIR/pnpm-shell-completion/pnpm-shell-completion.plugin.zsh"
source "$ZPLUGDIR/zsh-touchplus/touchplus.plugin.zsh"
source "$ZPLUGDIR/wakatime-zsh-plugin/wakatime.plugin.zsh"

#-----------------------------------------------------------
# Tool Integrations
#-----------------------------------------------------------
can_haz atuin  && eval "$(atuin init zsh --disable-up-arrow)"
can_haz zoxide && eval "$(zoxide init --cmd cd --hook pwd zsh)"
can_haz direnv && eval "$(direnv hook zsh)"
can_haz wt     && eval "$(wt shell-init zsh)"

# File sourcing
source ~/.alias.zshrc
source ~/.private.zshrc
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -f ~/.bin/functions.sh ]] && source ~/.bin/functions.sh

# Homebrew must precede /usr/bin in PATH to avoid system binaries taking priority.
# fnm must load after Homebrew so fnm-managed Node.js overrides Homebrew's Node.js.
export PATH="/opt/homebrew/bin:$PATH"
can_haz fnm && eval "$(fnm env --use-on-cd --version-file-strategy=recursive --resolve-engines --log-level=quiet)"

# OMP writes one session-cache file per shell and never reaps them — keep newest 50
() {
  setopt local_options extended_glob null_glob
  local -a _c=( ~/.cache/oh-my-posh/(shell|zsh).*.omp.cache(om) )
  (( $#_c > 50 )) && rm -f -- "${_c[51,-1]}"
} >/dev/null 2>&1 &!

# Performance profiling
[[ "$ZPROF" = true ]] && zprof
#-----------------------------------------------------------
# End of .zshrc
